{
    "name": "w4os/grav-plugin-w4os",
    "description": "Grav plugin: the website of an OpenSimulator grid, through the OpenSim engine API of the grid or the engine and helpers it bundles",
    "type": "grav-plugin",
    "license": "AGPL-3.0-or-later",
    "repositories": [
        {
            "name": "w4os/w4os-views",
            "url": "../w4os-views/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "w4os/w4os-engine",
            "url": "../opensim-engine/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "w4os/w4os-helpers",
            "url": "../opensim-helpers/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "magicoli/opensim-rest-php",
            "url": "../opensim-rest-php/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "name": "magicoli/container-tools",
            "url": "../container-tools/",
            "type": "path",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "package",
            "package": {
                "name": "npm-asset/tabler-core",
                "version": "1.7.5",
                "dist": {
                    "type": "tar",
                    "url": "https://registry.npmjs.org/@tabler/core/-/core-1.7.5.tgz",
                    "shasum": "1f9aea2f37d8048ac6df9217be6ce6c80b2f3081"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "npm-asset/tabler-icons-webfont",
                "version": "3.52.0",
                "dist": {
                    "type": "tar",
                    "url": "https://registry.npmjs.org/@tabler/icons-webfont/-/icons-webfont-3.52.0.tgz",
                    "shasum": "29a3484cbc7ef9347fc68b9f30a883be120538e7"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "npm-asset/tom-select",
                "version": "2.7.0",
                "dist": {
                    "type": "tar",
                    "url": "https://registry.npmjs.org/tom-select/-/tom-select-2.7.0.tgz",
                    "shasum": "87325ad8f308c1bdba3d1b8941171c3a485e4a94"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "npm-asset/leaflet",
                "version": "1.9.4",
                "dist": {
                    "type": "tar",
                    "url": "https://registry.npmjs.org/leaflet/-/leaflet-1.9.4.tgz",
                    "shasum": "23fae724e282fa25745aff82ca4d394748db7d8d"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "w4os/w4os-engine": "@dev",
        "w4os/w4os-helpers": "@dev",
        "magicoli/opensim-rest-php": "@dev",
        "npm-asset/tabler-core": "1.7.5",
        "npm-asset/tabler-icons-webfont": "3.52.0",
        "npm-asset/tom-select": "2.7.0",
        "w4os/w4os-views": "@dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.8 || ^4.0",
        "magicoli/bash-tools": "^1.0",
        "magicoli/build-tools": "^0.2.0"
    },
    "replace": {
        "guzzlehttp/psr7": "*",
        "psr/container": "*",
        "psr/http-factory": "*",
        "psr/http-message": "*",
        "psr/http-server-handler": "*",
        "psr/http-server-middleware": "*",
        "psr/log": "*",
        "ralouphie/getallheaders": "*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php80": "*",
        "symfony/yaml": "^7.4",
        "twig/twig": "*"
    },
    "autoload": {
        "psr-4": {
            "W4OS\\Grav\\": "classes/"
        }
    },
    "scripts": {
        "test": "pest",
        "languages": "php dev/languages.php",
        "post-install-cmd": [
            "W4OS\\Grav\\Assets::composer"
        ],
        "post-update-cmd": [
            "W4OS\\Grav\\Assets::composer"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "prepend-autoloader": false,
        "platform-check": false,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
