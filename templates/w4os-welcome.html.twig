{# The page a viewer shows before the login (welcome, in the grid info): the page alone, without the theme of the site, in the style
   of the helpers' pages, whatever asks it. A theme may give its own w4os-welcome.html.twig. #}
<!doctype html>
<html lang="{{ (grav.language.getActive ?: 'en')|e('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ page.title }}</title>
    {# The style of the helpers' own pages, the common one then the one of the client (page.<layer>.css), before the plugin's and the
       blocks' (w4os.css and its layer) #}
    {% do assets.addCss('plugin://w4os/vendor/w4os/w4os-helpers/assets/css/page.css', {priority: 21}) %}
    {% do assets.addCss('plugin://w4os/vendor/w4os/w4os-helpers/assets/css/page.' ~ w4os_layer() ~ '.css', {priority: 20}) %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
</head>
<body class="w4os-viewer viewer w4os-welcome">
    {{ page.content|raw }}
    {{ assets.js('bottom')|raw }}
</body>
</html>
