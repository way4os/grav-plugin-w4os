{# A page of the plugin in a viewer's panel (the Feed tab of a profile, the search, the guide): the page alone, without the theme of
   the site, compact for a small panel, as the helpers' own pages in a viewer: a block is the page there, under its own title (the
   guide's panel has it in it); a page without a block has the title of the page. Its content is the page's, as the plugin rendered
   it (w4os/page.html.twig). A theme may give its own w4os-viewer.html.twig. #}
<!doctype html>
<html lang="{{ (grav.language.getActive ?: 'en')|e('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ page.title }}</title>
    {# The style of the helpers' own pages, the common one then the one of the client (page.<layer>.css), before the plugin's and the
       blocks' (w4os.css and its layer, added with the files of the blocks) #}
    {% do assets.addCss('plugin://w4os/vendor/w4os/w4os-helpers/assets/css/page.css', {priority: 21}) %}
    {% do assets.addCss('plugin://w4os/vendor/w4os/w4os-helpers/assets/css/page.' ~ w4os_layer() ~ '.css', {priority: 20}) %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
</head>
<body class="w4os-viewer viewer">
    {# The layout of the helpers' pages: the grid, its column the content (main), which never grows wider than the panel #}
    <div class="layout content-only"><main id="main">{% if not page.header.w4os_block %}<h1>{{ page.title }}</h1>{% endif %}{{ page.content|raw }}</main></div>
    {{ assets.js('bottom')|raw }}
</body>
</html>
