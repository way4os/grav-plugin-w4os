{# A page of the plugin in a viewer's panel (the Feed tab of a profile, the search, the guide): the page alone, without the theme of
   the site, compact for a small panel. A theme may give its own w4os-viewer.html.twig. #}
{% set body %}{% include 'w4os/page.html.twig' %}{% endset %}
<!doctype html>
<html lang="{{ (grav.language.getActive ?: 'en')|e('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ page.title }}</title>
    {# The style of the helpers' own pages (the same in a viewer), then the plugin's, compact #}
    {% do assets.addCss('plugin://w4os/vendor/magicoli/opensim-helpers/assets/css/page.css', {priority: 20}) %}
    {% do assets.addCss('plugin://w4os/css/viewer.css', {priority: 5}) %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
</head>
<body class="w4os-viewer viewer">
    <main class="layout">{{ body|raw }}</main>
    {{ assets.js('bottom')|raw }}
</body>
</html>
