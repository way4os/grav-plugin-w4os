{# The parts of a list of the engine (w4os/list.html.twig): a sortable column title, a cell by the display type of its column, the
   actions menu of a row. A column may also show a picture before its value (`picture`: the attribute of an asset) and a tag after it
   (`tag`: a true attribute, `tagLabel` its text). #}

{# A column title sorts the list by its sort, a second click the other way #}
{% macro sorted(column, query, sort) %}
    {% set descending = sort.descending ?: '-' %}
    {% set current = query.sort ?? sort.default %}
    {% set down = current starts with descending %}
    {% set on = (down ? current[descending|length:] : current) == column.sort %}
    {% set next = on and not down ? descending ~ column.sort : column.sort %}
    <th class="w4os-cell-{{ column.type|e('html_attr') }}"{% if on %} aria-sort="{{ down ? 'descending' : 'ascending' }}"{% endif %}><a href="?{{ query|merge({sort: next})|url_encode }}">{{ ('w4os.' ~ column.label)|t }}{% if on %} <span aria-hidden="true">{{ down ? '↓' : '↑' }}</span>{% endif %}</a></th>
{% endmacro %}

{# The value of a column for a row, drawn by its type; nothing for an empty value. A value the column names (`values`: value,
   label) shows its label; a picture with nothing shows the engine's picture of nothing (`default`: person, or a place) #}
{% macro cell(column, item) %}
    {% set value = attribute(item, column.name) ?? null %}
    {% set type = column.type %}
    {% set labels = {} %}
    {% for known in column.values ?? [] %}{% set labels = labels|merge({(known.value): known.label}) %}{% endfor %}
    {% if column.picture is defined %}<div class="w4os-who"><img class="w4os-thumb" src="{{ w4os_picture(attribute(item, column.picture) ?? null, column.default ?? null)|e('html_attr') }}" alt="" loading="lazy" width="32" height="32"><span>{% endif %}
    {%- if type == 'date' -%}{{ value ? value|date('Y-m-d') }}
    {%- elseif type == 'boolean' -%}{{ value ? '✓' }}
    {%- elseif type == 'status' -%}{% if value is not empty %}<span class="w4os-status">{{ labels[value] is defined ? ('w4os.' ~ labels[value])|t : ('w4os.status_' ~ value)|t }}</span>{% endif %}
    {%- elseif type == 'role' -%}{% if value is not empty %}{{ labels[value] is defined ? ('w4os.' ~ labels[value])|t : ('w4os.role_' ~ value|replace({'-': '_'}))|t }}{% else %}{{ item.level ?? '' }}{% endif %}{% if item.standardLevel is defined and not item.standardLevel %} ({{ item.level }}){% endif %}
    {%- elseif type == 'picture' -%}<img class="w4os-thumb" src="{{ w4os_picture(value, column.default ?? null)|e('html_attr') }}" alt="" loading="lazy" width="32" height="32">
    {%- elseif type == 'map' -%}{% if value %}<img class="w4os-map-thumb" src="{{ w4os_picture(value)|e('html_attr') }}" alt="" loading="lazy" width="48" height="48">{% endif %}
    {%- elseif type == 'link' -%}{% set url = attribute(item, column.link ?? '') ?? null %}{% if url and value is not empty %}<a href="{{ url|e('html_attr') }}">{{ value }}</a>{% else %}{{ value }}{% endif %}
    {%- elseif type == 'hop' -%}{% if value %}<a href="{{ value|e('html_attr') }}" title="{{ value|e('html_attr') }}">{{ ('w4os.' ~ column.label)|t }}</a>{% endif %}
    {%- else -%}{{ (value is iterable ? value : (value is null ? [] : [value]))|map(v => labels[v] is defined ? ('w4os.' ~ labels[v])|t : v)|join(', ') }}
    {%- endif -%}
    {% if column.tag is defined and (attribute(item, column.tag) ?? false) %} <span class="w4os-tag">{{ ('w4os.' ~ (column.tagLabel ?? column.tag))|t }}</span>{% endif %}
    {% if column.picture is defined %}</span></div>{% endif %}
{% endmacro %}

{# The actions menu of a row: the links of the page (view, edit), then the engine's actions that apply to it, posted to the page #}
{% macro menu(list, item, links) %}
    {% set actions = w4os_list_actions(list, item) %}
    {% set id = item.uuid ?? item.id ?? '' %}
    <details class="w4os-menu">
        <summary aria-label="{{ ('w4os.actions'|t ~ ': ' ~ (item.name ?? ''))|e('html_attr') }}" title="{{ 'w4os.actions'|t|e('html_attr') }}">⋮</summary>
        <div class="w4os-menu-list">
            {% for link in links ?? [] %}
                <a href="{{ link.url|replace({'{uuid}': id|url_encode, '{name}': (item.name ?? '')|replace({' ': '.'})|url_encode})|e('html_attr') }}">{{ ('w4os.' ~ link.key)|t }}</a>
            {% endfor %}
            {% if actions %}
            <form method="post">
                {{ nonce_field('w4os-list')|raw }}
                <input type="hidden" name="id" value="{{ id|e('html_attr') }}">
                {% for action in actions %}<button name="action" value="{{ action.name|e('html_attr') }}">{{ ('w4os.' ~ action.label)|t }}</button>{% endfor %}
            </form>
            {% endif %}
        </div>
    </details>
{% endmacro %}
