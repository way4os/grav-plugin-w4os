{# The parts of a list of the engine (w4os/list.html.twig), drawn from the views of w4os-views: a sortable column title (ColumnView),
   a cell by the display type of its column, the indicators of a row (IndicatorView), its "…" menu (RowView). A column may also show
   a picture before its value (`picture`: the attribute of an asset) and a tag after it (`tag`: a true attribute, `tagLabel` its
   text). #}

{# A column title sorts the list by its sort, a second click the other way (ColumnView: sorted, descending, next) #}
{% macro sorted(column, query, wide = '') %}
    <th class="w4os-cell-{{ column.type|e('html_attr') }}{{ wide }}"{% if column.sorted %} aria-sort="{{ column.descending ? 'descending' : 'ascending' }}"{% endif %}><a href="?{{ query|merge({sort: column.next})|url_encode }}">{{ ('w4os.' ~ column.label)|t }}{% if column.sorted %} <span aria-hidden="true">{{ column.descending ? '↓' : '↑' }}</span>{% endif %}</a></th>
{% endmacro %}

{# The value of a column for a row, drawn by its type; nothing for an empty value. A value the column names (`values`: value,
   label, description) shows its label, its description as its tip; a picture with nothing shows the engine's picture of nothing (`default`: person, or a place);
   a day as a date; a time (datetime) in the style `dates` (W4OS\Views\Dates: `list` relative while recent, `long` with its time), its
   full date as its tip #}
{% macro cell(column, item, dates = 'list') %}
    {% set value = attribute(item, column.name) ?? null %}
    {% set type = column.type %}
    {% set labels = {} %}
    {% set tips = {} %}
    {% for known in column.values ?? [] %}
        {% set labels = labels|merge({(known.value): known.label}) %}
        {% if known.description is defined %}{% set tips = tips|merge({(known.value): known.description}) %}{% endif %}
    {% endfor %}
    {% if column.picture is defined %}<div class="w4os-who"><img class="w4os-thumb{{ (column.default ?? null) == 'person' ? ' w4os-thumb-person' }}" src="{{ w4os_picture(attribute(item, column.picture) ?? null, column.default ?? null)|e('html_attr') }}" alt="" width="32" height="32"><span>{% endif %}
    {%- if type == 'date' -%}{{ value|w4os_date }}
    {%- elseif type == 'datetime' -%}{% if value %}<time title="{{ value|w4os_date('full')|e('html_attr') }}">{{ value|w4os_date(dates) }}</time>{% endif %}
    {%- elseif type == 'boolean' -%}{{ value ? '✓' }}
    {%- elseif type == 'area' -%}{% if value is not null %}{{ w4os_area(value) }}{% endif %}
    {%- elseif type == 'usage' -%}{% if value is not null %}
        {#- A bar in the colour of its thresholds (orange from `warning`, red from `critical`), of its total when it has one -#}
        {%- set usage = column.usage ?? {} -%}
        {%- set tone = value >= (usage.critical ?? 90) ? 'danger' : (value >= (usage.warning ?? 70) ? 'warning' : 'success') -%}
        {%- set used = usage.used is defined ? attribute(item, usage.used) ?? null : null -%}
        {%- set total = usage.total is defined ? attribute(item, usage.total) ?? null : null -%}
        <div class="w4os-usage" title="{{ value }} %"><div class="progress progress-sm"><div class="progress-bar bg-{{ tone }}" style="width: {{ value }}%" role="progressbar" aria-valuenow="{{ value }}" aria-valuemin="0" aria-valuemax="100"></div></div>
        <div class="small text-secondary">{% if used is not null and total is not null %}{{ 'w4os.usage_of'|t(('w4os.' ~ (usage.unit ?? 'unit_mb'))|t(used|number_format), ('w4os.' ~ (usage.unit ?? 'unit_mb'))|t(total|number_format)) }}{% else %}{{ value }} %{% endif %}</div></div>
    {%- endif %}
    {%- elseif type == 'status' -%}{% if value is not empty %}<span class="w4os-status">{{ labels[value] is defined ? ('w4os.' ~ labels[value])|t : ('w4os.status_' ~ value)|t }}</span>{% endif %}
    {%- elseif type == 'role' -%}{% if value is not empty %}{{ labels[value] is defined ? ('w4os.' ~ labels[value])|t : ('w4os.role_' ~ value|replace({'-': '_'}))|t }}{% else %}{{ item.level ?? '' }}{% endif %}{% if item.standardLevel is defined and not item.standardLevel %} ({{ item.level }}){% endif %}
    {%- elseif type == 'picture' -%}<img class="w4os-thumb{{ (column.default ?? null) == 'person' ? ' w4os-thumb-person' }}" src="{{ w4os_picture(value, column.default ?? null)|e('html_attr') }}" alt="" width="32" height="32">
    {%- elseif type == 'map' -%}{% if value %}<img class="w4os-map-thumb" src="{{ w4os_picture(value)|e('html_attr') }}" alt="" width="48" height="48">{% endif %}
    {%- elseif type == 'link' -%}{% set url = attribute(item, column.link ?? '') ?? null %}{% if url and value is not empty %}<a href="{{ url|e('html_attr') }}">{{ value }}</a>{% else %}{{ value }}{% endif %}
    {%- elseif type == 'avatar' -%}{% if value %}{% set avatar = w4os_avatar_of(value) %}{% set profile = avatar.profilePage ?? null %}<div class="w4os-who"><img class="w4os-thumb w4os-thumb-person" src="{{ w4os_picture(avatar.profileImage ?? null, 'person')|e('html_attr') }}" alt="" width="32" height="32"><span>{% if profile %}<a href="{{ profile|e('html_attr') }}">{{ avatar.name }}</a>{% else %}{{ avatar.name ?? value }}{% endif %}</span></div>{% endif %}
    {%- elseif type == 'hop' -%}{% if value %}<a href="{{ value|e('html_attr') }}" title="{{ value|e('html_attr') }}">{{ ('w4os.' ~ column.label)|t }}</a>{% endif %}
    {%- else -%}
        {%- for v in (value is iterable ? value : (value is null ? [] : [value])) -%}
            {{ loop.first ? '' : ', ' }}{% if tips[v] is defined %}<span title="{{ ('w4os.' ~ tips[v])|t|e('html_attr') }}">{% endif %}{{ labels[v] is defined ? ('w4os.' ~ labels[v])|t : v }}{% if tips[v] is defined %}</span>{% endif %}
        {%- endfor -%}
    {%- endif -%}
    {% if column.tag is defined and (attribute(item, column.tag) ?? false) %} <span class="w4os-tag">{{ ('w4os.' ~ (column.tagLabel ?? column.tag))|t }}</span>{% endif %}
    {% if column.picture is defined %}</span></div>{% endif %}
{% endmacro %}

{# The indicators of a row (IndicatorView: the icon of its state, its tone, the label of its state as its title); the action of an
   icon is its button, with its confirmation (`ask`) #}
{% macro indicators(indicators, row) %}
    <span class="w4os-indicators">
    {%- for indicator in indicators -%}
        {% set text = ('w4os.' ~ indicator.label)|t %}
        {% set action = indicator.action %}
        {% if action %}<form method="post" class="w4os-indicator-form">{{ nonce_field('w4os-list')|raw }}<input type="hidden" name="id" value="{{ row.id|e('html_attr') }}"><button name="action" value="{{ action.name|e('html_attr') }}"{% if action.ask %} data-w4os-ask="{{ ('w4os.' ~ action.ask)|t|e('html_attr') }}" onclick="return confirm(this.dataset.w4osAsk)"{% endif %} class="w4os-indicator w4os-tone-{{ indicator.tone|e('html_attr') }}" title="{{ text|e('html_attr') }}"><i class="{{ w4os_icon(indicator.icon)|e('html_attr') }}" aria-hidden="true"></i><span class="sr-only visually-hidden">{{ text }} ({{ ('w4os.' ~ action.label)|t }})</span></button></form>
        {%- else -%}<span class="w4os-indicator w4os-tone-{{ indicator.tone|e('html_attr') }}" title="{{ text|e('html_attr') }}"><i class="{{ w4os_icon(indicator.icon)|e('html_attr') }}" aria-hidden="true"></i><span class="sr-only visually-hidden">{{ text }}</span></span>{% endif %}
    {%- endfor -%}
    </span>
{% endmacro %}

{# The actions of a row: its links (view, edit) as icons, the same as on the pages of the site (eye, pencil); then the "…" menu
   (Tabler's dropdown) of its other actions (RowView), posted to the page, the ones the engine asks to confirm (`ask`) last, apart
   and marked #}
{% macro menu(row) %}
    {% set icons = {action_view: 'ti ti-eye', action_view_item: 'ti ti-eye', action_edit: 'ti ti-pencil'} %}
    <div class="btn-list flex-nowrap justify-content-end">
    {% for link in row.links %}
        {% set label = ('w4os.' ~ link.key)|t %}
        {% if icons[link.key] is defined %}<a class="btn btn-ghost-secondary btn-icon btn-sm" href="{{ link.url|e('html_attr') }}" title="{{ label|e('html_attr') }}" aria-label="{{ (label ~ ': ' ~ (row.item.name ?? ''))|e('html_attr') }}"><i class="{{ icons[link.key] }}" aria-hidden="true"></i></a>{% endif %}
    {% endfor %}
    {% set others = row.links|filter(link => icons[link.key] is not defined) %}
    {% if others or row.actions %}
    <div class="dropdown w4os-menu">
        <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="{{ ('w4os.actions'|t ~ ': ' ~ (row.item.name ?? ''))|e('html_attr') }}" title="{{ 'w4os.actions'|t|e('html_attr') }}"><i class="ti ti-dots" aria-hidden="true"></i></button>
        <div class="dropdown-menu dropdown-menu-end">
            {% for link in others %}<a class="dropdown-item" href="{{ link.url|e('html_attr') }}">{{ ('w4os.' ~ link.key)|t }}</a>{% endfor %}
            {% if row.actions %}
            {% set safe = row.actions|filter(action => not action.danger) %}
            {% set asked = row.actions|filter(action => action.danger) %}
            <form method="post">
                {{ nonce_field('w4os-list')|raw }}
                <input type="hidden" name="id" value="{{ row.id|e('html_attr') }}">
                {% for action in safe %}<button name="action" value="{{ action.name|e('html_attr') }}" class="dropdown-item">{{ ('w4os.' ~ action.label)|t }}</button>{% endfor %}
                {% if asked %}
                    {% if others or safe %}<div class="dropdown-divider"></div>{% endif %}
                    {# Confirmed before it is sent, in the words of the engine (`ask`, a key of its catalog) #}
                    {% for action in asked %}<button name="action" value="{{ action.name|e('html_attr') }}" data-w4os-ask="{{ ('w4os.' ~ action.ask)|t|e('html_attr') }}" onclick="return confirm(this.dataset.w4osAsk)" class="dropdown-item text-danger">{{ ('w4os.' ~ action.label)|t }}</button>{% endfor %}
                {% endif %}
            </form>
            {% endif %}
        </div>
    </div>
    {% endif %}
    </div>
{% endmacro %}
