{# A manager changes an avatar of the grid (?avatar=<UUID>), under its header (w4os/edit-header.html.twig): the tabs of its own
   profile form, and its account, in a card #}
{% set edited = w4os_edited() %}
{% if edited is empty %}
    <div class="alert alert-danger" role="alert">{{ 'w4os.error_not_found'|t }}</div>
{% else %}
    <div class="card w4os-item"><div class="card-body">
        {% include 'w4os/admin-form.html.twig' with {form: forms('w4os-edit')} %}
    </div></div>
{% endif %}
{# The tab open kept in the address, the text areas grown where the browser cannot (its tabs and their scripts: admin-form) #}
{% do assets.addJs('plugin://w4os/js/keep-tab.js', {group: 'bottom', loading: 'defer'}) %}
