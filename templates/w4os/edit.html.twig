{# A manager changes an avatar of the grid (?avatar=<UUID>): the tabs of its own profile form, and its account #}
{% set edited = w4os_edited() %}
{% if edited is empty %}
    <p class="notices red">{{ 'w4os.error_not_found'|t }}</p>
{% else %}
    <p class="w4os-links"><a href="{{ base_url_relative ~ w4os_route('manage') }}">← {{ 'w4os.manage_title'|t }}</a></p>
    {% include 'forms/form.html.twig' with { form: forms('w4os-edit') } %}
{% endif %}
{# The tabs of the Form plugin need jQuery (Grav's collection); js/form-tabs.js makes them keyboard tabs, keeps the tab open in
   the address, and grows the text areas where the browser cannot #}
{% do assets.add('jquery', 101) %}
{% do assets.addJs('plugin://w4os/js/form-tabs.js', {group: 'bottom', loading: 'defer'}) %}
