{# The health of the grid, for the managers the contract lets read it (getHealth): what the engine checks now, group by group (a
   file of the grid and its section, what the grid says at get_grid_info, the pages, PHP, the folders and files the engine uses),
   each row its level, its address or its value, its answer and its time; then the addresses of the grid (getAddresses), where
   each comes from and who serves the pages. The engine's last report, with its time (checkedAt, relative, its full date as its
   tip; a row its own where it differs); checked again by its button (?refresh=1), a check that could not run said with the time of
   the report shown. #}
{% set data = w4os_health() %}
{% if data.error %}
    <div class="alert alert-danger" role="alert">{{ data.error }}</div>
{% endif %}
{% if data.health %}
    {% set checked = data.health.checkedAt ?? null %}
    {% if data.refreshError %}
        <div class="alert alert-warning" role="alert">{{ 'w4os.admin_health_refresh_failed'|t(data.refreshError, checked ? checked|w4os_date('list') : '?') }}</div>
    {% endif %}
    {# The level of the report and its time; the script checks the lines again one by one and says it here (js/health.js) #}
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 w4os-health-banner" data-checked="{{ 'w4os.admin_health_checked'|t('%s')|e('html_attr') }}" data-ok="{{ 'w4os.admin_health_ok'|t|e('html_attr') }}" data-error="{{ 'w4os.admin_health_error'|t|e('html_attr') }}" data-failed="{{ 'w4os.admin_health_not_checked'|t('%s')|e('html_attr') }}">
        <div class="alert {{ data.health.level == 'error' ? 'alert-danger' : 'alert-success' }} mb-0 flex-fill" role="status">
            <span class="w4os-health-level">{{ data.health.level == 'error' ? 'w4os.admin_health_error'|t : 'w4os.admin_health_ok'|t }}</span>
            {%- if checked %} <span class="text-secondary">· <span class="w4os-health-checked" title="{{ checked|w4os_date('long')|e('html_attr') }}">{{ 'w4os.admin_health_checked'|t(checked|w4os_date('list')) }}</span></span>{% endif %}
        </div>
        <a class="btn" href="{{ (page.route ?? '') ~ '?refresh=1' }}" data-w4os-health-check><i class="ti ti-refresh me-1" aria-hidden="true"></i>{{ 'w4os.admin_health_check'|t }}</a>
    </div>
    {# The heads of the columns of each kind of line (health-row.html.twig) #}
    {% set heads = {
        address: ['w4os.admin_health_address', 'w4os.admin_health_expected', 'w4os.admin_health_answer'],
        value: ['w4os.admin_health_value', 'w4os.admin_health_expected'],
        secret: ['w4os.admin_health_set'],
        requirement: ['w4os.admin_health_state', 'w4os.admin_health_version'],
        folder: ['w4os.admin_health_exists', 'w4os.admin_health_writable'],
        file: ['w4os.admin_health_readable'],
        option: ['w4os.admin_health_state'],
    } %}
    {% set firsts = {requirement: 'w4os.admin_health_extension', folder: 'w4os.admin_health_path', file: 'w4os.admin_health_path', option: 'w4os.admin_health_instance'} %}
    {% for group in data.health.groups ?? [] %}
        <div class="card mb-3 w4os-health-group">
            {# The instance the file is of (Robust, a simulator, the money server: the context of its lines), the file, the section #}
            {% set instance = (group.rows|first).context.instance ?? null %}
            <div class="card-header"><h3 class="card-title">{% if instance %}<span class="badge bg-secondary-lt">{{ instance }}</span> {% endif %}<code>{{ group.file }}</code>{% if group.title %} <span class="text-secondary">{{ group.title }}</span>{% endif %}</h3></div>
            {# One table for each kind of line of the group, in the order they come #}
            {% set kinds = [] %}
            {% for row in group.rows %}{% set kind = row.kind ?? (row.text is defined ? 'value' : 'address') %}{% if kind not in kinds %}{% set kinds = kinds|merge([kind]) %}{% endif %}{% endfor %}
            {% for kind in kinds %}
            <div class="table-responsive">
                <table class="table table-vcenter card-table w4os-health-{{ kind|e('html_attr') }}">
                    <thead><tr>
                        <th class="w-1"><span class="visually-hidden">{{ 'w4os.column_status'|t }}</span></th>
                        <th>{{ (firsts[kind] ?? 'w4os.admin_health_setting')|t }}</th>
                        {% for head in heads[kind] ?? heads.option %}<th>{{ head|t }}</th>{% endfor %}
                        <th class="w-1 text-end text-nowrap">{{ 'w4os.admin_health_time'|t }}</th>
                    </tr></thead>
                    <tbody>
                    {% for row in group.rows|filter(row => (row.kind ?? (row.text is defined ? 'value' : 'address')) == kind) %}
                        {% include 'w4os/health-row.html.twig' with {row: row, checked: checked} %}
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endfor %}
        </div>
    {% endfor %}
    {% do assets.addJs('plugin://w4os/js/health.js', {group: 'bottom', loading: 'defer'}) %}
{% endif %}
{% if data.addresses.services ?? false %}
    {# The addresses of the grid by their use (the Robust services, the helpers the simulators and the viewers call, the pages, the
       web tools, the web assets, the tasks), then their file and section, each its exact key, its name (its description as its tip),
       its address and where it comes from; what is not set says so #}
    {% set usages = {
        'robust-viewers': 'w4os.usage_robust_viewers', 'robust-simulators': 'w4os.usage_robust_simulators',
        'helper-viewers': 'w4os.usage_helper_viewers', 'helper-simulators': 'w4os.usage_helper_simulators', 'page': 'w4os.usage_page',
        'web-tool': 'w4os.usage_web_tool', 'web-assets': 'w4os.usage_web_assets', 'task': 'w4os.usage_task',
    } %}
    {% set sources = {
        provider: 'w4os.admin_health_source_provider', config: 'w4os.admin_health_source_config', live: 'w4os.admin_health_source_live',
        default: 'w4os.admin_health_source_default', simulator: 'w4os.admin_health_source_simulator',
    } %}
    {% set services = data.addresses.services %}
    {% for usage in usages|keys|merge(services|map(s => (s.usage ?? ''))|filter(u => (u and usages[u] is not defined))) %}
        {% set rows = services|filter(s => (s.usage ?? '') == usage)|sort((a, b) => (((a.file ?? '~') ~ (a.section ?? '') ~ (a.setting ?? a.key)) <=> ((b.file ?? '~') ~ (b.section ?? '') ~ (b.setting ?? b.key)))) %}
        {% if rows %}
        <div class="card mb-3 w4os-health-addresses">
            <div class="card-header"><h3 class="card-title">{{ usages[usage] is defined ? usages[usage]|t : usage }}</h3></div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead><tr>
                        <th>{{ 'w4os.admin_health_setting'|t }}</th>
                        <th>{{ 'w4os.admin_health_service'|t }}</th>
                        <th>{{ 'w4os.admin_health_address'|t }}</th>
                        <th>{{ 'w4os.admin_health_source'|t }}</th>
                    </tr></thead>
                    <tbody>
                    {% set place = null %}
                    {% for row in rows %}
                        {% set here = (row.file ?? '') ~ '|' ~ (row.section ?? '') %}
                        {% if here != place and (row.file or row.section) %}
                            <tr class="bg-transparent"><th colspan="4" class="fw-normal">{% if row.file %}<code>{{ row.file }}</code>{% endif %}{% if row.section %} <span class="text-secondary">[{{ row.section }}]</span>{% endif %}</th></tr>
                        {% endif %}
                        {% set place = here %}
                        <tr>
                            <td>{% if row.setting %}<code>{{ row.setting }}</code>{% endif %}</td>
                            <td{% if row.description %} title="{{ ('w4os.' ~ row.description)|t|e('html_attr') }}"{% endif %}>{{ row.label ? ('w4os.' ~ row.label)|t : row.key }}</td>
                            <td class="text-break">{% if row.url %}<a href="{{ row.url|e('html_attr') }}" target="_blank" rel="noopener">{{ row.url }}</a>{% else %}<span class="text-secondary">{{ 'w4os.health_unset'|t }}</span>{% endif %}</td>
                            <td class="text-secondary">{% if row.source %}{{ sources[row.source] is defined ? sources[row.source]|t : row.source }}{% endif %}{% if data.addresses.servedBy[row.key] is defined %} <span class="badge bg-secondary-lt">{{ data.addresses.servedBy[row.key] }}</span>{% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}
    {% endfor %}
{% elseif data.addresses %}
    <div class="card mb-3 w4os-health-addresses">
        <div class="card-header"><h3 class="card-title">{{ 'w4os.admin_health_addresses'|t }}</h3></div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr>
                    <th>{{ 'w4os.admin_health_service'|t }}</th>
                    <th>{{ 'w4os.admin_health_address'|t }}</th>
                    <th>{{ 'w4os.admin_health_source'|t }}</th>
                </tr></thead>
                <tbody>
                {% for name, url in data.addresses.addresses ?? {} %}
                    <tr>
                        <td><code>{{ name }}</code>{% if data.addresses.servedBy[name] is defined %} <span class="badge bg-secondary-lt">{{ data.addresses.servedBy[name] }}</span>{% endif %}</td>
                        <td class="text-break">{% if url %}<a href="{{ url|e('html_attr') }}" target="_blank" rel="noopener">{{ url }}</a>{% else %}<span class="text-secondary">{{ 'w4os.health_unset'|t }}</span>{% endif %}</td>
                        <td class="text-secondary">{{ data.addresses.sources[name] ?? '' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
