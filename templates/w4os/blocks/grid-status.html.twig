{# The status of the grid, from the data of the block of the helpers (grid-status?format=json), in the language of the site. #}
{% set users = data.monitor.users ?? {} %}
{% set regions = data.monitor.regions ?? {} %}
{# The keyword the viewers read, as the helpers give it: not translated #}
{% set keyword = {ok: 'ONLINE', degraded: 'DEGRADED', down: 'OFFLINE'}[data.monitor.level ?? ''] ?? null %}
<section class="block block-grid-status">
    <h3 class="block-title">{{ 'w4os.grid_status'|t }}</h3>
    <table class="block-table">
        {% if keyword %}<tr><th scope="row">{{ 'w4os.status'|t }}</th><td>{{ keyword }}</td></tr>{% endif %}
        <tr><th scope="row">{{ 'w4os.regions'|t }}</th><td>{{ w4os_number(regions.online ?? 0) }} / {{ w4os_number(regions.total ?? 0) }}</td></tr>
        {% for key in ['members', 'active_members', 'members_in_world', 'active_users', 'total_users'] %}
            {% if users[key] is defined %}<tr><th scope="row">{{ ('w4os.' ~ key)|t }}</th><td>{{ w4os_number(users[key]) }}</td></tr>{% endif %}
        {% endfor %}
        {% if users.area is defined %}<tr><th scope="row">{{ 'w4os.area'|t }}</th><td>{{ w4os_area(users.area) }}</td></tr>{% endif %}
    </table>
</section>
