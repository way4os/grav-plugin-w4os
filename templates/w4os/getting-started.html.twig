{# The Connect block (w4os_start_steps()): create the avatar, add the grid to the viewer, log in. The step to do now stands out, the
   ones done are marked. start_title: the title of the block, Connect by default; start_level: its level, h2 by default. #}
{% set level = start_level|default('h2') %}
{% set steps = w4os_start_steps() %}
{% set avatar = w4os_avatar() %}
{% set grid = w4os_grid_name() %}
{% set uri = w4os_login_uri() %}
{% set links = w4os_add_grid() %}
<section class="w4os-start">
    <{{ level }} class="w4os-start-title">{{ start_title|default('w4os.start_title'|t) }}</{{ level }}>
    <ol class="w4os-start-steps">
        {% for item in steps %}
        {% set button = item.state == 'next' ? 'btn btn-primary' : 'btn btn-ghost' %}
        <li class="w4os-start-step w4os-start-{{ item.step }} is-{{ item.state }}"{% if item.state == 'next' %} aria-current="step"{% endif %}>
            {% if item.state == 'done' %}<span class="visually-hidden">{{ 'w4os.start_done'|t }}</span>{% endif %}
            {% if item.step == 'avatar' %}
                {% if avatar %}
                <p><a href="{{ w4os_profile_page()|e('html_attr') }}">{{ 'w4os.start_avatar_done'|t(avatar.name) }}</a></p>
                {% elseif w4os_route('register') %}
                <a class="{{ button }}" href="{{ (base_url_relative ~ w4os_route('register'))|e('html_attr') }}">{{ 'w4os.start_avatar'|t }}</a>
                {% else %}
                <a class="{{ button }}" href="{{ (base_url_relative ~ (config.plugins.login.route ?: '/login'))|e('html_attr') }}">{{ 'w4os.log_in'|t }}</a>
                {% endif %}
            {% elseif item.step == 'viewer' %}
                {% if links %}<a class="{{ button }} w4os-add-grid-button" href="{{ links.hop|e('html_attr') }}">{{ 'w4os.start_add_grid'|t(grid) }}</a>{% endif %}
                {% if uri %}
                <p class="w4os-start-uri">{% include 'w4os/login-uri.html.twig' %}</p>
                {% endif %}
            {% elseif item.step == 'login' and uri %}
                <a class="{{ button }} w4os-login-button" href="{{ w4os_login_link()|e('html_attr') }}">{{ 'w4os.start_login'|t }}</a>
            {% endif %}
        </li>
        {% endfor %}
    </ol>
</section>
