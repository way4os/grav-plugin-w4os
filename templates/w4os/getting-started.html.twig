{# The Connect block (w4os_start_steps()): create the avatar, add the grid to the viewer, log in. The step to do now stands out, the
   ones done are marked. start_title: the title of the block, Connect by default; start_level: its level, h2 by default;
   start_content and start_footer: texts of the site (Markdown) between the title and the steps, and under them, nothing when empty. #}
{% set level = start_level|default('h2') %}
{% set steps = w4os_start_steps() %}
{% set avatar = w4os_avatar() %}
{% set uri = w4os_login_uri() %}
{% set links = w4os_add_grid() %}
<section class="w4os-start">
    <{{ level }} class="w4os-start-title">{{ start_title|default('w4os.start_title'|t) }}</{{ level }}>
    {% if start_content|default('')|trim %}<div class="w4os-start-content">{{ start_content|w4os_text }}</div>{% endif %}
    <ol class="w4os-start-steps">
        {% for item in steps %}
        {% set kind = item.state == 'next' ? 'primary' : 'button' %}
        <li class="w4os-start-step w4os-start-{{ item.step }} is-{{ item.state }}"{% if item.state == 'next' %} aria-current="step"{% endif %}>
            {% if item.state == 'done' %}<span class="visually-hidden">{{ 'w4os.start_done'|t }}</span>{% endif %}
            {% if item.step == 'avatar' %}
                {% if avatar %}
                <p><a href="{{ w4os_profile_page()|e('html_attr') }}">{{ 'w4os.start_avatar_done'|t(avatar.name) }}</a></p>
                {% elseif w4os_route('register') %}
                {{ w4os_link(w4os_route('register'), 'w4os.start_avatar'|t, kind) }}
                {% else %}
                {{ w4os_link(config.plugins.login.route ?: '/login', 'w4os.log_in'|t, kind) }}
                {% endif %}
            {% elseif item.step == 'viewer' %}
                {# Once the avatar has been in the world, the grid is in its viewer: its login URI alone #}
                {% if links and item.state != 'done' %}{{ w4os_anchor(links.hop, 'w4os.start_add_grid'|t, kind, 'w4os-add-grid-button') }}{% endif %}
                {% if uri %}
                <p class="w4os-start-uri">{% include 'w4os/login-uri.html.twig' with {only: ['copy']} %}</p>
                {% endif %}
            {% elseif item.step == 'login' and uri %}
                {{ w4os_anchor(w4os_login_link(), (item.state == 'done' ? 'w4os.start_login_done' : 'w4os.start_login')|t, kind, 'w4os-login-button') }}
            {% endif %}
        </li>
        {% endfor %}
    </ol>
    {% if start_footer|default('')|trim %}<div class="w4os-start-footer">{{ start_footer|w4os_text(true) }}</div>{% endif %}
</section>
