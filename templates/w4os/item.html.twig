{# The page of an item of the engine (?id=<UUID>, w4os_item in the front matter: its type, the page of its list), under its header
   (w4os/item-header.html.twig): a card with its views as tabs, its details (its fields as the engine describes them, by group)
   and, with &edit=1, the form of the fields the visitor changes #}
{% import 'w4os/list-cells.html.twig' as cells %}
{% import 'w4os/item-parts.html.twig' as parts %}
{% set page_item = w4os_item() %}
{% if page_item.item is empty %}
    <div class="alert alert-danger" role="alert">{{ page_item.error ?? 'w4os.error_not_found'|t }}</div>
{% else %}
    {% set id = page_item.item.uuid ?? page_item.item.id ?? '' %}
    <div class="card w4os-item">
        {% set lists = page_item.lists ?? [] %}
        {% set tab = page_item.tab ?? null %}
        {{ parts.tabs([{url: '?' ~ {id: id}|url_encode, label: 'w4os.tab_overview'|t, active: not page_item.edit and not tab}]
            |merge(page_item.changeable ? [{url: '?' ~ {id: id, edit: 1}|url_encode, label: 'w4os.action_edit'|t, active: page_item.edit and not tab}] : [])
            |merge(lists|map(list => {url: '?' ~ {id: id, tab: list.type}|url_encode, label: ('w4os.' ~ list.label)|t, active: tab == list.type}))) }}
        <div class="card-body">
        {% if tab %}
            {# A list of its own (the parcels of a region): the engine's list kept to the item, its links keeping the item and the tab #}
            {% set own = lists|filter(list => list.type == tab)|first %}
            {% set data = w4os_list({type: own.type, fixed: {(own.filter): id}}) %}
            {% include 'w4os/list.html.twig' with {
                list: data.list, items: data.items, meta: data.meta, query: (data.query ?? {})|merge({id: id, tab: tab}), fixed: data.fixed ?? {}, error: data.error,
                links: [], texts: {search: 'w4os.' ~ own.search, empty: 'w4os.' ~ own.empty, count: 'w4os.' ~ own.count, title: 'w4os.' ~ own.label}
            } %}
        {% elseif page_item.edit %}
            {% include 'w4os/admin-form.html.twig' with {form: forms('w4os-item')} %}
            {% do assets.add('jquery', 101) %}
            {% do assets.addJs('plugin://w4os/js/form-tabs.js', {group: 'bottom', loading: 'defer'}) %}
        {% else %}
            {# Its fields, but the ones its header shows (w4os-views ItemView): its name, its picture, its state #}
            {% for group in w4os_item_view(page_item).groups %}
                {% if loop.length > 1 %}<h3 class="card-title{{ loop.first ? '' : ' mt-4' }}">{{ ('w4os.' ~ group.label)|t }}</h3>{% endif %}
                <div class="datagrid">
                {% for field in group.fields %}
                    <div class="datagrid-item">
                        <div class="datagrid-title">{{ ('w4os.' ~ field.label)|t }}</div>
                        <div class="datagrid-content">{{ cells.cell(field, page_item.item, 'long') }}</div>
                    </div>
                {% endfor %}
                </div>
            {% endfor %}
        {% endif %}
        </div>
    </div>
{% endif %}
