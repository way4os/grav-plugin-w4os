{# The login URI of a grid (uri): its address as a teleport link (w4os_tp_link, the links the engine gives for it), the one that adds
   the grid to the viewer first, its menu with the exact address to copy. #}
{% if uri %}<span class="w4os-uri-field">{{ w4os_tp_link(uri, uri, '<code class="w4os-login-uri">' ~ uri|e ~ '</code>') }}</span>{% endif %}
