{# A card of the dashboard: the regions of the grid, online of all, then by simulator (the engine's monitor), each leading to the
   list of its regions #}
{% set monitor = w4os_monitor() %}
{% set list = base_url_relative ~ w4os_route('regions') %}
<section class="block block-regions">
    <h3 class="block-title">{% if w4os_route('regions') %}<a href="{{ list }}">{{ 'w4os.regions_title'|t }}</a>{% else %}{{ 'w4os.regions_title'|t }}{% endif %}</h3>
    {% if monitor.regions is defined %}
        <p>{{ 'w4os.regions_online'|t(monitor.regions.online, monitor.regions.total) }}</p>
        {% if monitor.simulators ?? [] %}
        <ul class="w4os-simulators">
            {% for simulator in monitor.simulators %}
                {# The list of its regions: the simulator filter takes its address (host:port of its uri) #}
                {% set address = (simulator.uri ?? '')|replace({'http://': '', 'https://': ''})|trim('/') %}
                <li>{% if address and w4os_route('regions') %}<a href="{{ list ~ '?' ~ {'simulator[]': address}|url_encode }}">{{ simulator.name }}</a>{% else %}{{ simulator.name }}{% endif %}
                    <small>{{ 'w4os.regions_online'|t(simulator.online, simulator.regions) }}</small></li>
            {% endfor %}
        </ul>
        {% endif %}
    {% else %}
        <p>{{ 'w4os.error_channel_unavailable'|t }}</p>
    {% endif %}
</section>
