{# The ways out of the account page, in the page itself whatever the theme draws around it: the profile of the avatar, the admin
   for a manager, sign out #}
{% set admin = w4os_admin_menu() %}
<nav class="w4os-account-links" aria-label="{{ 'w4os.menu_account'|t|e('html_attr') }}">
    <ul>
        <li><a href="{{ w4os_profile_page() }}">{{ 'w4os.profile_title'|t }}</a></li>
        {% if admin %}<li><a href="{{ (admin|first).url }}">{{ 'w4os.menu_admin'|t }}</a></li>{% endif %}
        <li><a href="{{ url(uri.addNonce((uri.path)|trim('/') ~ '/task' ~ config.system.param_sep ~ 'login.logout', 'logout-form', 'logout-nonce'))|e }}">{{ 'w4os.logout'|t }}</a></li>
    </ul>
</nav>
