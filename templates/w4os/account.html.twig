{# The profile of the avatar signed in, organized like the viewer's profile window (the tabs of the form), its account (email,
   password) in the last tab #}
{% if w4os_avatar() is empty %}
    <p class="notices red">{{ 'w4os.error_channel_unavailable'|t }}</p>
{% else %}
    {% include 'forms/form.html.twig' with { form: forms('w4os-profile') } %}
{% endif %}
