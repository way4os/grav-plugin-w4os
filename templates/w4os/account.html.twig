{# The profile of the avatar signed in, organized like the viewer's profile window (the tabs of the form), its account (email,
   password) in the last tab #}
{% if w4os_avatar() is empty %}
    <p class="notices red">{{ 'w4os.error_channel_unavailable'|t }}</p>
{% else %}
    {% include 'forms/form.html.twig' with { form: forms('w4os-profile') } %}
{% endif %}
{# The tabs of the Form plugin need jQuery (Grav's collection); js/form-tabs.js makes them keyboard tabs, keeps the tab open in
   the address, and grows the text areas where the browser cannot #}
{% do assets.add('jquery', 101) %}
{% do assets.addJs('plugin://w4os/js/form-tabs.js', {group: 'bottom', loading: 'defer'}) %}
{% do assets.addJs('plugin://w4os/js/keep-tab.js', {group: 'bottom', loading: 'defer'}) %}
