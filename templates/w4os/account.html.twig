{# The profile of the avatar signed in, organized like the viewer's profile window (the tabs of the form), its account (email,
   password) in the last tab #}
{% if w4os_avatar() is empty %}
    <p class="notices red">{{ 'w4os.error_channel_unavailable'|t }}</p>
{% else %}
    {% include 'forms/form.html.twig' with { form: forms('w4os-profile') } %}
    {# The profile page of the avatar and signing out, plain links (signing out found here too in a theme without the entries
       under my avatar in its menu) #}
    <p class="w4os-links"><a href="{{ w4os_profile_page() }}">{{ 'w4os.action_view'|t }}</a> · <a href="{{ base_url_relative }}{{ w4os_logout_route() }}">{{ 'w4os.logout'|t }}</a></p>
{% endif %}
