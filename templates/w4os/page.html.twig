{# The content of a page of the plugin (pages/*.md), in a theme's page or in a viewer's panel (w4os-viewer.html.twig): a block of
   the helpers (search, profile, guide: `w4os_block` of the page), else its part (templates/w4os/<type>.html.twig). Its title first,
   as the text of a page of the site has its own (the themes show the content of a page alone); a viewer's layout has its own. #}
{# The messages given while the page renders (the notices of the blocks of the helpers), put here by the plugin #}
<!-- w4os:messages -->
<div class="w4os w4os-page w4os-{{ page.header.w4os|e('html_attr') }}">
    {% if not w4os_is_viewer() %}<h1>{{ page.title }}</h1>{% endif %}
    {% if page.header.w4os_block %}
        {# A profile its owner or a manager may change: the way to its edit page #}
        {% set edit_url = page.header.w4os == 'profile' and not w4os_is_viewer() ? w4os_profile_edit_url() : null %}
        {# The stream of a profile its own avatar looks at: the form that writes a post at its top, a delete button on each post #}
        {% set posts = page.header.w4os == 'profile' ? w4os_posts() : null %}
        {% if posts %}
            {% set compose %}{% include 'forms/form.html.twig' with { form: forms('w4os-post') } %}{% endset %}
            {{ w4os_in_feed(w4os_block(page.header.w4os_block, w4os_page_args()|merge({title: ''})), compose, posts) }}
        {% else %}
            {{ w4os_block(page.header.w4os_block, w4os_page_args()|merge({title: ''})) }}
        {% endif %}
        {% if edit_url %}
            {# Its action under it, a link with the theme's classes of a button (the Form plugin's form_button_classes); the tab open
               goes with it (js/keep-tab.js) #}
            <div class="form-wrapper w4os-profile-actions">
                <div class="{{ form_button_outer_classes ?: 'buttons' }}">
                    <a href="{{ edit_url }}" class="{{ form_button_classes ?: 'button' }}" data-w4os-keep-tab>{{ 'w4os.action_edit'|t }}</a>
                </div>
            </div>
        {% endif %}
    {% else %}
        {% include 'w4os/' ~ page.header.w4os ~ '.html.twig' %}
    {% endif %}
</div>
