{# A form of the plugin in the admin (form): the Form plugin's form in Tabler's classes, by the variables the Form plugin reads #}
{% set form_field_outer_classes = 'mb-3' %}
{% set form_field_label_classes = 'form-label' %}
{% set form_field_input_classes = 'form-control' %}
{% set form_field_select_classes = 'form-select' %}
{% set form_field_textarea_classes = 'form-control' %}
{% set form_field_checkbox_classes = 'form-check-input' %}
{% set form_button_outer_classes = 'btn-list justify-content-end' %}
{% set form_button_classes = 'btn' %}
{% include 'forms/form.html.twig' with {form: form} %}
