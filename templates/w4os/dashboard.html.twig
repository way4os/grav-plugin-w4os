{# The managers' dashboard (Tabler): its cards in their order (w4os_cards of its page), in columns that leave a small card small:
   a block of the helpers (the grid info and status, as the widgets of w4os-wp); how many of a list its filter keeps of all it knows
   (the regions online of the known ones), leading to both; the counts of a list in one card, each by the plain name of its value,
   leading to the list so filtered; the first rows of a list as it sorts them (the recent users), with a link to them all. #}
{% import 'w4os/list-cells.html.twig' as cells %}
{% set cards = w4os_dashboard() %}
{# The problems the last health report of the grid found, as w4os-wp says them in its notices: how many errors and warnings (red
   with an error, orange with warnings only), the first ones, leading to the Health page #}
{% set problems = w4os_health_problems() %}
{% if (problems.count ?? 0) or (problems.warnings ?? 0) %}
    <div class="alert {{ problems.count ? 'alert-danger' : 'alert-warning' }}" role="alert">
        {{ w4os_health_counts(problems.count, problems.warnings ?? 0) }} <span aria-hidden="true">·</span>
        {% for label in problems.labels %}<code>{{ label }}</code>{% if problems.statuses[loop.index0] ?? '' %} ({{ problems.statuses[loop.index0] }}){% endif %}{{ loop.last ? '' : ', ' }}{% endfor %}{{ (problems.count ?: problems.warnings ?? 0) > problems.labels|length ? '…' : '' }}
        <a class="alert-link" href="{{ problems.url|e('html_attr') }}">{{ 'w4os.admin_health_title'|t }}</a>
    </div>
{% endif %}
<div class="w4os-dashboard">
    {% for card in cards %}
    {# Every card the same: its title in its header, its content, the link to its list in its footer, at the right #}
    {% set title = card.kind == 'block' or card.kind == 'rows' ? card.title : 'w4os.' ~ card.page ~ '_title' %}
    <div class="w4os-dashboard-card">
        <div class="card{{ card.kind in ['count', 'counts'] ? ' w4os-stat' }}">
            <div class="card-header"><h3 class="card-title">{{ title|t }}</h3>
            {%- if card.kind == 'rows' %}
                {% set sort = card.list.sort.default ?? '' %}
                {% set by = card.list.columns|filter(c => c.name == sort|trim('-', 'left'))|first %}
                {# The column its rows are sorted by; a time, its zone with it, once for the rows #}
                {% if by %}<div class="card-actions text-secondary">{{ ('w4os.' ~ by.label)|t }}{% if (by.type ?? '') == 'datetime' and card.items is not empty %} · {{ w4os_zone() }}{% endif %}</div>{% endif %}
            {%- endif %}</div>
            {% if card.kind == 'block' %}
                <div class="card-body w4os-dashboard-block">{{ w4os_block(card.block, card.args|merge({title: ''})) }}</div>
            {% elseif card.kind == 'count' %}
                {# How many of all: online of the known ones, more to come beside it later #}
                <div class="card-body"><div class="h1 mb-0">{{ card.total is null ? '—' : card.part ~ '/' ~ card.total }}</div>
                {% if card.error %}<div class="text-danger small mt-1">{{ card.error }}</div>{% endif %}</div>
            {% elseif card.kind == 'counts' %}
                <div class="list-group list-group-flush">
                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="{{ card.url|e('html_attr') }}">
                        <span class="flex-fill">{{ 'w4os.total'|t }}</span><span class="h3 mb-0">{{ card.total ?? '—' }}</span>
                    </a>
                {% for count in card.counts %}
                    {# The plain name of what it counts: the label of the value of its filter (Online, Pending, Default Model) #}
                    {% set name = count.filter|keys|first %}
                    {% set filter = card.list.filters|filter(f => f.name == name)|first %}
                    {% set known = (filter.values ?? [])|filter(v => v.value == count.filter[name])|first %}
                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="{{ count.url|e('html_attr') }}">
                        <span class="flex-fill">{{ known ? (known.text ?? ('w4os.' ~ known.label)|t) : count.filter[name] }}</span>
                        <span class="h3 mb-0">{{ count.total ?? '—' }}</span>
                    </a>
                {% endfor %}
                </div>
                {% if card.error %}<div class="card-body text-danger small">{{ card.error }}</div>{% endif %}
            {% elseif card.kind == 'rows' %}
                {# The first rows of a list: its first column (the name, leading to the page of the row), and the column it is sorted by #}
                {% set first = card.list.columns|first %}
                <div class="list-group list-group-flush">
                {% for item in card.items %}
                    {% set id = item.uuid ?? item.id ?? '' %}
                    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="{{ card.item ? (card.item.url ~ '?' ~ {(card.item.param): id}|url_encode) : card.url }}">
                        <span class="flex-fill text-truncate">{{ cells.cell(first, item)|striptags('<img><div><span>')|raw }}</span>
                        {% if by %}<span class="text-secondary text-nowrap">{{ cells.cell(by, item) }}</span>{% endif %}
                    </a>
                {% else %}
                    <div class="empty"><p class="empty-title">{{ ('w4os.no_' ~ card.list.type)|t }}</p></div>
                {% endfor %}
                </div>
            {% endif %}
            {% if card.url ?? false %}<div class="card-footer text-end">{{ w4os_link(card.url, 'w4os.see_all'|t, 'more') }}</div>{% endif %}
        </div>
    </div>
    {% endfor %}
</div>
