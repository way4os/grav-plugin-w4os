{# The visit of the grid for the avatars of other grids, a callout: what to do (with the grids they may come from, when the site names
   some: setting hypergrid.examples), the address to enter in the map or the search of a viewer (the grid's gatekeeper, host:port,
   to copy), the button that takes a viewer there. Nothing when the grid is not reachable by hypergrid. hg_title: its title (Visit
   from another grid by default); hg_level: the level of its title (h2). #}
{% set hypergrid = w4os_hypergrid() %}
{% if hypergrid %}
{% set level = hg_level|default('h2') %}
<aside class="w4os-callout w4os-hypergrid-visit">
    <{{ level }} class="w4os-callout-title">{{ hg_title|default('w4os.hg_visit_title'|t) }}</{{ level }}>
    <p>{{ hypergrid.examples|default('') ? 'w4os.hg_visit_text_examples'|t(hypergrid.examples) : 'w4os.hg_visit_text'|t }}</p>
    <p class="w4os-hypergrid-address">{% include 'w4os/login-uri.html.twig' with {uri: hypergrid.address} %}</p>
    <p class="w4os-hypergrid-go">{{ w4os_tp_link(hypergrid.address, 'w4os.hg_visit_go'|t) }}</p>
</aside>
{% endif %}
