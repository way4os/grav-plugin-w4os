{# A list of the engine as the admin draws it (Tabler), from the engine's description of it (Contract::listOf() of w4os-views:
   its columns and their types, its sorts, its filters and their values, its search, the actions of a row). Variables: list,
   items, meta, query (the query of the page), fixed (the filters the page always asks one value of: their column and the filter
   are left out), error, texts (the keys of its search placeholder, of no row, of the count, of its title), links (the links of a
   row: key, url with {uuid}, or attribute: the address the row gives; the first one is the link of its name). The labels of the
   engine are keys of its catalog, under w4os.
   What it shows comes from w4os-views (ListView): its first column is the name of the row, the secondary ones show in their column
   on a wide screen (xl), in a grey line under the name on a narrower one; the status (indicators) and the "…" menu at every width. #}
{% import 'w4os/list-cells.html.twig' as cells %}
{# What to show, from w4os-views (ListView): the filters and what the page asks of them, the columns and the secondary ones, the
   rows with their link, address, indicators and menu, the filters chosen and the query that removes them, the pages #}
{# None when the engine does not describe the list (it does not answer): the error alone #}
{% set view = list ? w4os_list_view(list, error ? [] : items, error ? {} : meta, query, links ?? [], fixed ?? {}) : null %}
{# Its views, as w4os-wp shows them above its table: All, then the values of the filters the engine shows as views (views), each
   with the number of rows it gives, the one asked in bold; these filters are not in the toolbar #}
{% if view and view.views %}
<ul class="list-inline w4os-views mb-2">
    {% for item in view.views %}
    <li class="list-inline-item"><a href="?{{ item.query|url_encode }}"{% if item.current %} class="fw-bold text-reset" aria-current="page"{% endif %}>{{ item.filter is null ? 'w4os.all'|t : (item.text ?? (item.label ? ('w4os.' ~ item.label)|t : item.value)) }}{% if item.count is not null %} <span class="text-secondary">({{ item.count }})</span>{% endif %}</a></li>
    {% endfor %}
</ul>
{% endif %}
{# The toolbar: the search, then the filters at their width (their empty option names them), on one line when there is room;
   Enter asks the list again #}
<form class="w4os-filters d-flex flex-wrap align-items-center gap-2 mb-3" method="get">
    {% if list.search is not null %}
    <div class="input-icon w4os-search" role="search">
        <span class="input-icon-addon"><i class="ti ti-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control" name="search" value="{{ query.search ?? '' }}" placeholder="{{ texts.search|t|e('html_attr') }}" aria-label="{{ texts.search|t|e('html_attr') }}">
        <button type="submit" class="visually-hidden">{{ 'w4os.search'|t }}</button>
    </div>
    {% endif %}
    <div class="d-flex flex-wrap gap-2 w4os-filter-fields" role="group" aria-label="{{ 'w4os.filters'|t|e('html_attr') }}">
    {% for filter in view ? view.filters|filter(f => f.name not in (list.views ?? [])) : [] %}
        {% set label = ('w4os.' ~ filter.label)|t %}
        {% if filter.field == 'multiple' %}
        {# The choices of a filter as the same field (Tom Select, js/filters.js): several values, any of them, its label as its
           placeholder; or one value, its label greyed while none is chosen, a × to remove it (without the script, its first option
           asks for any). The meaning of each value as its tip, the number of rows it gives after it when the engine counts them (the
           value chosen shows without it, its data-label) #}
        <select class="form-select" name="{{ filter.name|e('html_attr') }}[]" multiple data-w4os-filter data-clear="{{ 'w4os.filter_clear'|t|e('html_attr') }}" placeholder="{{ label|e('html_attr') }}" aria-label="{{ label|e('html_attr') }}" onchange="this.form.requestSubmit()">
            {% for value in filter.values %}<option value="{{ value.value|e('html_attr') }}"{% if value.description %} title="{{ ('w4os.' ~ value.description)|t|e('html_attr') }}"{% endif %}{% set text = value.text ?? (value.label ? ('w4os.' ~ value.label)|t : value.value) %}{% if value.count is not null %} data-label="{{ text|e('html_attr') }}"{% endif %}{{ value.chosen ? ' selected' }}>{{ text }}{% if value.count is not null %} ({{ value.count }}){% endif %}</option>{% endfor %}
        </select>
        {% elseif filter.field == 'text' %}
        <input type="text" class="form-control" name="{{ filter.name|e('html_attr') }}" value="{{ filter.chosen|first|default('') }}" placeholder="{{ label|e('html_attr') }}" aria-label="{{ label|e('html_attr') }}" onchange="this.form.requestSubmit()">
        {% else %}
        <select class="form-select" name="{{ filter.name|e('html_attr') }}" data-w4os-filter data-clear="{{ 'w4os.filter_clear'|t|e('html_attr') }}" data-chosen="{{ 'w4os.label_value'|t(label, '%s')|e('html_attr') }}" aria-label="{{ label|e('html_attr') }}" onchange="this.form.requestSubmit()">
            <option value="">{{ 'w4os.filter_any'|t }}</option>
            {% for value in filter.values %}<option value="{{ value.value|e('html_attr') }}"{% if value.description %} title="{{ ('w4os.' ~ value.description)|t|e('html_attr') }}"{% endif %}{% set text = value.text ?? (value.label ? ('w4os.' ~ value.label)|t : value.value) %}{% if value.count is not null %} data-label="{{ text|e('html_attr') }}"{% endif %}{{ value.chosen ? ' selected' }}>{{ text }}{% if value.count is not null %} ({{ value.count }}){% endif %}</option>{% endfor %}
        </select>
        {% endif %}
    {% endfor %}
    </div>
    {% if query.sort is defined %}<input type="hidden" name="sort" value="{{ query.sort }}">{% endif %}
</form>
{% if view and view.filters|filter(f => f.field != 'text') %}
    {# Its styles are the admin's (Tom Select in Tabler's theme) #}
    {% do assets.addJs('plugin://w4os/vendor/npm-asset/tom-select/dist/js/tom-select.popular.min.js', {group: 'bottom', loading: 'defer'}) %}
    {% do assets.addJs('plugin://w4os/js/filters.js', {group: 'bottom', loading: 'defer'}) %}
{% endif %}
{% if error %}
    <div class="alert alert-danger" role="alert">{{ error }}</div>
{% else %}
    {% if view.rows is not empty or view.activeFilters %}
    <p class="text-secondary w4os-count mb-2">
        {{ w4os_count(texts.count, view.total) }}
        {% if view.activeFilters %} · {{ w4os_count('w4os.filters_active', view.activeFilters) }} <a class="text-secondary" href="?{{ view.clearQuery|url_encode }}" title="{{ 'w4os.filter_clear'|t|e('html_attr') }}" aria-label="{{ 'w4os.filter_clear'|t|e('html_attr') }}"><i class="ti ti-x" aria-hidden="true"></i></a>{% endif %}
    </p>
    {% endif %}
    <div class="card w4os-list-card">
    {% if view.rows is empty %}
        <div class="empty">
            <p class="empty-title">{{ texts.empty|t }}</p>
        </div>
    {% else %}
        {% set menu = links or list.actions %}
        {# The breakpoint of Tabler from which a column shows, by its priority (1: at every width); below it, its value in the grey
           line under the name #}
        {% set tiers = {2: 'md', 3: 'xl'} %}
        <div class="table-responsive">
        <table class="table table-vcenter card-table w4os-list w4os-{{ list.type|e('html_attr') }}">
            <thead><tr>
                {% for column in view.columns %}
                    {% set wide = column.primary ? '' : ' d-none d-' ~ (tiers[column.priority] ?? 'xxl') ~ '-table-cell' %}
                    {% if column.sort %}{{ cells.sorted(column, view.query, wide) }}{% else %}<th class="w4os-cell-{{ column.type|e('html_attr') }}{{ wide }}">{{ ('w4os.' ~ column.label)|t }}</th>{% endif %}
                {% endfor %}
                {% if menu %}<th class="w-1"><span class="visually-hidden">{{ 'w4os.actions'|t }}</span></th>{% endif %}
            </tr></thead>
            <tbody>
            {% for row in view.rows %}
                <tr{% if row.status %} class="w4os-{{ row.status|e('html_attr') }}"{% endif %}>
                {% for column in view.columns %}
                    {% if column.type == 'indicators' %}
                    <td class="w4os-cell-indicators{{ column.primary ? '' : ' d-none d-' ~ (tiers[column.priority] ?? 'xxl') ~ '-table-cell' }}">{{ cells.indicators(row.indicators[column.name] ?? [], row) }}</td>
                    {% elseif loop.first %}
                    <td class="w4os-cell-{{ column.type|e('html_attr') }}{{ column.definition.picture is defined ? ' w4os-cell-who' }}">
                        {% if row.link %}<a class="text-reset w4os-row-link" href="{{ row.link|e('html_attr') }}">{{ cells.cell(column.definition, row.item) }}</a>{% else %}{{ cells.cell(column.definition, row.item) }}{% endif %}
                        {% if row.subtitle %}<div class="w4os-subtitle text-secondary">{% if row.subtitleLink %}<a class="text-secondary" href="{{ row.subtitleLink|e('html_attr') }}">{{ row.subtitle }}</a>{% else %}{{ row.subtitle }}{% endif %}</div>{% endif %}
                        {# The columns hidden at this width, in a grey line, each until its column shows (the ones shown first first,
                           so that the ones left are its end); a value that does not say what it is (a date, a number, a name) after the
                           label of its column #}
                        {% set parts = [] %}
                        {% for other in view.secondary %}
                            {# A group: each of its values with its own label #}
                            {% for shown in other.type == 'group' ? other.definition.parts : [other.definition] %}{% set part = cells.cell(shown, row.item)|striptags|trim %}{% if part %}{% set parts = parts|merge([{text: (other.type == 'group' ? (shown.bare ?? false) : other.bare) ? part : 'w4os.label_value'|t(('w4os.' ~ shown.label)|t, part), tier: tiers[other.priority] ?? 'xxl'}]) %}{% endif %}{% endfor %}
                        {% endfor %}
                        {% if parts %}<div class="w4os-subtitle text-secondary w4os-folded d-{{ (parts|last).tier }}-none">{% for part in parts %}<span class="d-{{ part.tier }}-none">{{ part.text }}</span>{% endfor %}</div>{% endif %}
                    </td>
                    {% else %}
                    <td class="w4os-cell-{{ column.type|e('html_attr') }}{{ column.definition.picture is defined ? ' w4os-cell-who' }}{{ column.primary ? '' : ' d-none d-' ~ (tiers[column.priority] ?? 'xxl') ~ '-table-cell' }}">{{ cells.cell(column.definition, row.item) }}</td>
                    {% endif %}
                {% endfor %}
                {% if menu %}<td class="w4os-actions">{{ cells.menu(row) }}</td>{% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {# The pages of the list: the links keep the search, the filters and the sort #}
        {% if view.pages > 1 %}
        <div class="card-footer d-flex align-items-center">
            <ul class="pagination m-0 ms-auto" aria-label="{{ texts.title|t|e('html_attr') }}">
                <li class="page-item{{ view.page > 1 ? '' : ' disabled' }}"><a class="page-link" href="?{{ view.query|merge({page: view.page - 1})|url_encode }}" rel="prev" aria-label="‹"><i class="ti ti-chevron-left" aria-hidden="true"></i></a></li>
                {% for n in 1..view.pages %}
                <li class="page-item{{ n == view.page ? ' active' }}"><a class="page-link" href="?{{ view.query|merge({page: n})|url_encode }}"{% if n == view.page %} aria-current="page"{% endif %}>{{ n }}</a></li>
                {% endfor %}
                <li class="page-item{{ view.page < view.pages ? '' : ' disabled' }}"><a class="page-link" href="?{{ view.query|merge({page: view.page + 1})|url_encode }}" rel="next" aria-label="›"><i class="ti ti-chevron-right" aria-hidden="true"></i></a></li>
            </ul>
        </div>
        {% endif %}
    {% endif %}
    </div>
{% endif %}
