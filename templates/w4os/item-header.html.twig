{# The header of the page of an item: its name, its state, its links and its actions (w4os/item-parts.html.twig); its title without the item #}
{% import 'w4os/item-parts.html.twig' as parts %}
{% set page_item = w4os_item() %}
{% if page_item.item is empty %}
    {% include 'w4os/admin-header.html.twig' %}
{% else %}
    {% set back = page_item.list ? {url: base_url_relative ~ w4os_route(page_item.list), label: ('w4os.' ~ page_item.list ~ '_title')|t} : null %}
    {# Its links: the addresses the item gives (w4os_item.links of the page: key, attribute, id), its profile page... #}
    {% set links = [] %}
    {% for link in page.header.w4os_item.links ?? [] %}
        {% set url = attribute(page_item.item, link.attribute) ?? null %}
        {% if url %}{% set links = links|merge([{url: url, label: ('w4os.' ~ link.key)|t} + (link.id is defined ? {id: link.id} : {})]) %}{% endif %}
    {% endfor %}
    {{ parts.header(w4os_item_view(page_item), back, links) }}
{% endif %}
