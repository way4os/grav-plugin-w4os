{# The settings of the site, in Tabler's settings layout: its sections as narrow side tabs (the fieldsets of the form), the form
   beside them; its choices as the other choices of the admin (Tom Select, js/select.js) #}
{% set sections = page.header.form.fields|filter(field => field.type == 'fieldset') %}
{% do assets.addJs('plugin://w4os/vendor/npm-asset/tom-select/dist/js/tom-select.popular.min.js', {group: 'bottom', loading: 'defer'}) %}
{% do assets.addJs('plugin://w4os/js/select.js', {group: 'bottom', loading: 'defer'}) %}
<div class="card w4os-settings-card">
    <div class="row g-0">
        <div class="col-12 col-md-auto border-end w4os-settings-nav">
            <div class="card-body">
                <nav class="list-group list-group-transparent" aria-label="{{ 'w4os.admin_site_settings'|t|e('html_attr') }}">
                    {% for name, section in sections %}
                        <a href="#w4os-settings-{{ name|e('html_attr') }}" class="list-group-item list-group-item-action d-flex align-items-center{{ loop.first ? ' active' }}">{{ section.title|t }}</a>
                    {% endfor %}
                </nav>
            </div>
        </div>
        <div class="col">
            <div class="card-body w4os-settings-body">
                {% include 'w4os/admin-form.html.twig' with { form: forms('w4os-settings') } %}
            </div>
        </div>
    </div>
</div>
