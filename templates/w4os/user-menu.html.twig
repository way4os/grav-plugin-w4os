{# The menu of the visitor, for the top bar of a theme. Signed in: the name of the avatar leads to its profile page, its list (on
   hover or focus) has the edit page of its profile and sign out (the managers have the admin menu, w4os/admin-menu.html.twig). Not signed in: "Log in" leads to the login page, its list has
   register and lost password. #}
{% set routes = config.plugins.w4os.routes %}
{% set login_route = config.plugins.login.route|default('/login') %}
<div class="w4os-user-menu">
    {% if grav.user.authenticated %}
        <a class="w4os-user-current" href="{{ grav.user.w4os ? w4os_profile_page() : w4os_url(login_route) }}" aria-haspopup="true"><i class="fa-solid fa-user" aria-hidden="true"></i> {{ grav.user.fullname ?: grav.user.username }}</a>
        <ul class="w4os-user-list">
            {% if grav.user.w4os %}<li><a href="{{ w4os_url(routes.account) }}">{{ 'w4os.edit_profile'|t }}</a></li>{% endif %}
            <li><a href="{{ url(uri.addNonce((uri.path)|trim('/') ~ '/task' ~ config.system.param_sep ~ 'login.logout', 'logout-form', 'logout-nonce'))|e }}">{{ 'w4os.logout'|t }}</a></li>
        </ul>
    {% else %}
        <a class="w4os-user-current" href="{{ w4os_url(login_route) }}" aria-haspopup="true"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> {{ 'w4os.log_in'|t }}</a>
        <ul class="w4os-user-list">
            {% if w4os_route('register') %}<li><a href="{{ w4os_url(w4os_route('register')) }}">{{ 'w4os.register'|t }}</a></li>{% endif %}
            <li><a href="{{ w4os_url(routes.forgot) }}">{{ 'w4os.forgot_title'|t }}</a></li>
        </ul>
    {% endif %}
</div>
