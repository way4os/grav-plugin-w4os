{# The models a rule picks (models), each its picture and the name to show (label: without the name of the rule), its full name
   under it; what the engine says when there is none (rule.preview.empty) #}
{% if models %}
    <div class="row row-cards">
        {% for model in models %}
            <div class="col-6 col-sm-4 col-lg-6">
                <div class="card card-sm">
                    <img class="card-img-top w4os-model-picture" src="{{ model.image|e('html_attr') }}" alt="" loading="lazy">
                    <div class="card-body p-2">
                        <div class="fw-medium">{{ model.label ?? model.name }}</div>
                        <div class="small text-secondary">{{ model.name }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <p class="text-secondary mb-0">{{ ('w4os.' ~ (rule.preview.empty ?? 'models_match_help'))|t }}</p>
{% endif %}
