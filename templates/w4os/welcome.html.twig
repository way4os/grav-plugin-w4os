{# The page a viewer shows before the login (welcome, in the grid info), as the helpers' splash page: the message of the day (a
   welcome) and what the grid is (its info, its status) on the left, the title of the site and its popular places in the middle; one
   column on a narrow screen. In w4os-welcome.html.twig, the page alone. #}
<div class="layout with-sidebars">
    <aside class="sidebar sidebar-left">
        {{ w4os_block('motd', {level: 'h2'}) }}
        {{ w4os_block('grid-info', {level: 'h2'}) }}
        {{ w4os_block('grid-status', {level: 'h2'}) }}
    </aside>
    <main id="main">
        <h1>{{ page.title }}</h1>
        {{ w4os_block('popular-places', {level: 'h2'}) }}
    </main>
</div>
