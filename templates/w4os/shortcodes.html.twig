{# The shortcodes of the site and the blocks of the helpers they show, as the page Shortcodes of w4os-wp: each its code and what it
   shows, its live preview (a block of the helpers, as a page shows it), the table of its options #}
<p class="text-secondary">{{ 'w4os.shortcodes_help'|t }}</p>
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table w4os-shortcodes">
            <tbody>
            {% for shortcode in w4os_shortcodes() %}
                <tr>
                    <th class="fw-normal w4os-shortcode-code"><code>{{ shortcode.code }}</code><p class="text-secondary small mt-2 mb-0">{{ ('w4os.' ~ shortcode.help)|t }}</p></th>
                    <td class="w4os-shortcode-preview">{% if shortcode.block is defined %}{{ w4os_block(shortcode.block, {title: '', level: 'h3'}) }}{% endif %}</td>
                    <td class="w4os-shortcode-options">
                        {% if shortcode.options %}
                        <p class="mb-1">{{ 'w4os.shortcode_options'|t }}</p>
                        <table class="table table-sm mb-0">
                            {% for option in shortcode.options %}<tr><th class="fw-normal"><code>{{ option.option }}</code></th><td class="text-secondary">{{ ('w4os.' ~ option.help)|t }}</td></tr>{% endfor %}
                        </table>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
