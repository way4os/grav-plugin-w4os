{# The home page of a grid, as content of any page (the shortcode [w4os-home]...[/w4os-home], in the theme's default page): the
   text of the page, the popular places and the guide (where the text has the marker <!--w4os-blocks-->, if it has one), then what the grid is (its info, its status, its message of the day, the Connect block, its texts
   start_title, start_content and start_footer from the front matter of the page, or as a theme that extends it sets them), and the
   last news of the site (its page /news, when it has one) with a link to all of them.
   Side by side only where the content is wide enough (css/w4os.css, container queries), the text first otherwise; the theme's own
   column, if it has one, stays the theme's. The main column a section, its blocks titled h2 (the page's own title is h1); the
   others asides, their blocks titled h3. A theme adds its own boxes to the asides by extending this template
   ({% extends '@w4os/w4os/home.html.twig' %}) and filling the blocks w4os_home_grid_extra (under what the grid is),
   w4os_home_news_before (above the news) and w4os_home_news_extra (under the news); it moves the message of the day and the Connect
   block to the other aside by giving w4os_home_grid only {{ block('w4os_home_grid_info') }} and w4os_home_news_before
   {{ block('w4os_home_connect') }}. #}
{% set news = w4os_home_news() %}
<div class="w4os-home">
    <div class="w4os-home-layout">
        <section class="w4os-home-main">
            {# The text, then the popular places and the guide, then what the text has after the marker <!--w4os-blocks-->, if any #}
            {% set text = content|split('<!--w4os-blocks-->', 2) %}
            {{ text[0]|raw }}
            {{ w4os_block('popular-places', {level: 'h2'}) }}
            {{ w4os_block('destination_guide', {level: 'h2'}) }}
            {{ (text[1] ?? '')|raw }}
        </section>
        <aside class="w4os-home-grid">
            {% block w4os_home_grid %}
                {% block w4os_home_grid_info %}
                    {{ w4os_block('grid-info', {level: 'h3'}) }}
                    {{ w4os_block('grid-status', {level: 'h3'}) }}
                {% endblock %}
                {% block w4os_home_connect %}
                    {{ w4os_block('motd', {level: 'h3'}) }}
                    {% include 'w4os/getting-started.html.twig' with {start_level: 'h3', start_title: start_title ?? grav.page.header.start_title ?? '', start_content: start_content ?? grav.page.header.start_content ?? '', start_footer: start_footer ?? grav.page.header.start_footer ?? ''} %}
                {% endblock %}
                {% block w4os_home_grid_extra %}{% endblock %}
            {% endblock %}
        </aside>
        <aside class="w4os-home-news">
            {% block w4os_home_news_before %}{% endblock %}
            {% if news %}
            <section class="w4os-latest">
                <h3 class="w4os-latest-title">{{ news.title }}</h3>
                {% for item in news.collection()|slice(0, 3) %}
                {% set image = (item.header.thumb ?? false) ? item.media[item.header.thumb] : item.media.images|first %}
                <article class="w4os-latest-item">
                    {% if image %}<a class="w4os-latest-image" href="{{ item.url|e('html_attr') }}" tabindex="-1" aria-hidden="true">{{ image.cropZoom(600, 338).html('', '')|raw }}</a>{% endif %}
                    <h4><a href="{{ item.url|e('html_attr') }}">{{ item.title }}</a></h4>
                    <p>{{ ((item.header.intro ?? '') ?: item.content|striptags|trim)|truncate(140, true, ' ', '…') }}</p>
                    <p class="w4os-latest-date"><time datetime="{{ item.date|date('Y-m-d') }}">{{ item.date|w4os_date }}</time></p>
                </article>
                {% endfor %}
                <p class="w4os-latest-all">{{ w4os_link(news.url, 'w4os.home_all_news'|t, 'more') }}</p>
            </section>
            {% endif %}
            {% block w4os_home_news_extra %}{% endblock %}
        </aside>
    </div>
</div>
