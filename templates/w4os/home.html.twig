{# The home page of a grid, as content of any page (the shortcode [w4os-home]...[/w4os-home], in the theme's default page): the
   text of the page, the popular places and the guide, then what the grid is (its info, its status, the Connect block) and its
   message of the day with the last news of the site (its page /news, when it has one) and a link to all of them.
   Side by side only where the content is wide enough (css/w4os.css, container queries), the text first otherwise; the theme's own
   column, if it has one, stays the theme's. The main column a section, its blocks titled h2 (the page's own title is h1); the
   others asides, their blocks titled h3. A theme adds its own boxes to the asides by extending this template
   ({% extends '@w4os/w4os/home.html.twig' %}) and filling the blocks w4os_home_grid_extra and w4os_home_news_extra. #}
{% set news = w4os_home_news() %}
<div class="w4os-home">
    <div class="w4os-home-layout">
        <section class="w4os-home-main">
            {{ content|raw }}
            {{ w4os_block('popular-places', {level: 'h2'}) }}
            {{ w4os_block('destination_guide', {level: 'h2'}) }}
        </section>
        <aside class="w4os-home-grid">
            {{ w4os_block('grid-info', {level: 'h3'}) }}
            {{ w4os_block('grid-status', {level: 'h3'}) }}
            {% include 'w4os/getting-started.html.twig' with {start_level: 'h3'} %}
            {% block w4os_home_grid_extra %}{% endblock %}
        </aside>
        <aside class="w4os-home-news">
            {{ w4os_block('motd', {level: 'h3'}) }}
            {% if news %}
            <section class="w4os-latest">
                <h3 class="w4os-latest-title">{{ news.title }}</h3>
                {% for item in news.collection()|slice(0, 3) %}
                {% set image = (item.header.thumb ?? false) ? item.media[item.header.thumb] : item.media.images|first %}
                <article class="w4os-latest-item">
                    {% if image %}<a class="w4os-latest-image" href="{{ item.url|e('html_attr') }}" tabindex="-1" aria-hidden="true">{{ image.cropZoom(600, 338).html('', '')|raw }}</a>{% endif %}
                    <h4><a href="{{ item.url|e('html_attr') }}">{{ item.title }}</a></h4>
                    <p>{{ ((item.header.intro ?? '') ?: item.content|striptags|trim)|truncate(140, true, ' ', '…') }}</p>
                    <p class="w4os-latest-date"><time datetime="{{ item.date|date('Y-m-d') }}">{{ item.date|w4os_date }}</time></p>
                </article>
                {% endfor %}
                <p class="w4os-latest-all"><a href="{{ news.url|e('html_attr') }}">{{ 'w4os.home_all_news'|t }}</a></p>
            </section>
            {% endif %}
            {% block w4os_home_news_extra %}{% endblock %}
        </aside>
    </div>
</div>
