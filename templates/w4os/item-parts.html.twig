{# The parts of the page of an item in the admin (Tabler): its header, its tabs, its details. #}

{# The header (Tabler's page header) of an item from its view (w4os-views ItemView): the link back to its list, its picture and its
   name as its list shows them, its state as badges (the icon and the label of each state, in its tone: green, grey, orange, red), at
   the right the links given (`links`: url, label, id) and the menu (vertical dots) of the engine's actions that apply to it, the ones the engine
   asks to confirm last, apart and marked #}
{% macro header(view, back = null, links = []) %}
    {% set tones = {ok: 'green', off: 'secondary', warning: 'orange', failed: 'red'} %}
    <div class="page-header d-print-none w4os-item-header">
        <div class="container-fluid">
            <div class="row g-3 align-items-center">
                {% if view.pictured %}
                <div class="col-auto">
                    {{ w4os_picture_tag(view.picture, view.pictureDefault, 'w4os-item-picture' ~ (view.round ? ' rounded-circle' : ' rounded'), 64) }}
                </div>
                {% endif %}
                <div class="col">
                    {% if back %}<div class="page-pretitle"><a href="{{ back.url|e('html_attr') }}"><i class="ti ti-chevron-left" aria-hidden="true"></i>{{ back.label }}</a></div>{% endif %}
                    <h2 class="page-title">{{ view.name }}</h2>
                    <div class="d-flex flex-wrap gap-2 mt-2 w4os-item-states">
                    {% for state in view.states %}<span class="badge bg-{{ tones[state.tone] ?? 'secondary' }}-lt"><i class="{{ w4os_icon(state.icon)|e('html_attr') }} me-1" aria-hidden="true"></i>{{ ('w4os.' ~ state.label)|t }}</span>{% endfor %}
                    </div>
                </div>
                {% if links or view.actions %}
                <div class="col-12 col-md-auto ms-auto">
                    <div class="btn-list">
                        {% for link in links %}<a class="btn"{% if link.id is defined %} id="{{ link.id|e('html_attr') }}"{% endif %} href="{{ link.url|e('html_attr') }}">{{ link.label }}</a>{% endfor %}
                        {% if view.actions %}
                        <div class="dropdown">
                            <button type="button" class="btn btn-icon" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ 'w4os.actions'|t|e('html_attr') }}" title="{{ 'w4os.actions'|t|e('html_attr') }}"><i class="ti ti-dots-vertical" aria-hidden="true"></i></button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <form method="post">
                                    {{ nonce_field('w4os-list')|raw }}
                                    <input type="hidden" name="id" value="{{ view.id|e('html_attr') }}">
                                    {% for action in view.actions %}
                                        {% if action.danger and loop.index0 > 0 and not view.actions[loop.index0 - 1].danger %}<div class="dropdown-divider"></div>{% endif %}
                                        {% if action.danger %}<button class="dropdown-item text-danger" name="action" value="{{ action.name|e('html_attr') }}" data-w4os-ask="{{ ('w4os.' ~ action.ask)|t|e('html_attr') }}" onclick="return confirm(this.dataset.w4osAsk)">{{ ('w4os.' ~ action.label)|t }}</button>{% else %}<button class="dropdown-item" name="action" value="{{ action.name|e('html_attr') }}">{{ ('w4os.' ~ action.label)|t }}</button>{% endif %}
                                    {% endfor %}
                                </form>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}

{# The tabs of an item (Tabler's tabs of a card): its views (`tabs`: url, label, active) #}
{% macro tabs(tabs) %}
    {% if tabs|length > 1 %}
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs">
            {% for tab in tabs %}<li class="nav-item"><a class="nav-link{{ tab.active ? ' active' }}" href="{{ tab.url|e('html_attr') }}"{% if tab.active %} aria-current="page"{% endif %}>{{ tab.label }}</a></li>{% endfor %}
        </ul>
    </div>
    {% endif %}
{% endmacro %}
