{% set list = w4os_avatars() %}
<form class="w4os-search" method="get">
    <input type="search" name="search" value="{{ uri.query('search')|e('html_attr') }}" placeholder="{{ 'w4os.search_avatars'|t|e('html_attr') }}">
    <button class="button" type="submit">{{ 'w4os.search'|t }}</button>
</form>
{% if list.error %}
    <p class="notices red">{{ list.error }}</p>
{% elseif list.items is empty %}
    <p>{{ 'w4os.no_avatars'|t }}</p>
{% else %}
    <p class="w4os-count">{{ 'w4os.avatars_count'|t(list.meta.total ?? list.items|length) }}</p>
    <div class="w4os-table-wrap">
    <table class="w4os-avatars">
        <thead><tr>
            <th>{{ 'w4os.avatar_name'|t }}</th><th>{{ 'w4os.email'|t }}</th><th>{{ 'w4os.status'|t }}</th>
            <th>{{ 'w4os.last_seen'|t }}</th><th>{{ 'w4os.created'|t }}</th><th>{{ 'w4os.actions'|t }}</th>
        </tr></thead>
        <tbody>
        {% for a in list.items %}
            <tr class="{{ a.active ? 'active' : 'inactive' }}">
                <td>{{ a.name }}{% if a.isGod %} <span class="w4os-tag">{{ 'w4os.god'|t }}</span>{% endif %}</td>
                <td>{{ a.email }}</td>
                <td>{{ a.online ? 'w4os.online'|t : (a.active ? 'w4os.active'|t : 'w4os.inactive'|t) }}</td>
                <td>{{ a.lastSeen ? a.lastSeen|date('Y-m-d') : '—' }}</td>
                <td>{{ a.created ? a.created|date('Y-m-d') : '—' }}</td>
                <td class="w4os-actions">
                    {% for action in (a.active ? ['disable', 'reset', 'delete'] : ['enable', 'delete']) %}
                        <form method="post"{% if action == 'delete' %} onsubmit="return confirm('{{ 'w4os.delete_confirm'|t(a.name)|e('js') }}')"{% endif %}>
                            {{ nonce_field('w4os-manage')|raw }}
                            <input type="hidden" name="uuid" value="{{ a.uuid|e('html_attr') }}">
                            <input type="hidden" name="name" value="{{ a.name|e('html_attr') }}">
                            <button class="button small {{ action == 'delete' ? 'danger' : '' }}" name="action" value="{{ action }}">{{ ('w4os.action_' ~ action)|t }}</button>
                        </form>
                    {% endfor %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% set pages = ((list.meta.total ?? 0) / (list.meta.perPage ?: 50))|round(0, 'ceil') %}
    {% if pages > 1 %}
        <p class="w4os-pages">
        {% for n in 1..pages %}
            {% if n == (list.meta.page ?? 1) %}<strong>{{ n }}</strong>{% else %}<a href="?{{ {search: uri.query('search'), page: n}|url_encode }}">{{ n }}</a>{% endif %}
        {% endfor %}
        </p>
    {% endif %}
{% endif %}
