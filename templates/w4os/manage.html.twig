{% set list = w4os_avatars() %}
<form class="w4os-search" method="get">
    <input type="search" name="search" value="{{ uri.query('search')|e('html_attr') }}" placeholder="{{ 'w4os.search_avatars'|t|e('html_attr') }}">
    <button class="button" type="submit">{{ 'w4os.search'|t }}</button>
</form>
{% if list.error %}
    <p class="notices red">{{ list.error }}</p>
{% elseif list.items is empty %}
    <p>{{ 'w4os.no_avatars'|t }}</p>
{% else %}
    <p class="w4os-count">{{ 'w4os.avatars_count'|t(list.meta.total ?? list.items|length) }}</p>
    <div class="w4os-table-wrap">
    <table class="w4os-avatars">
        <thead><tr>
            <th>{{ 'w4os.avatar_name'|t }}</th><th>{{ 'w4os.email'|t }}</th>
            <th>{{ 'w4os.last_seen'|t }}</th><th>{{ 'w4os.created'|t }}</th>
            <th>{{ 'w4os.status'|t }}</th><th><span class="sr-only">{{ 'w4os.actions'|t }}</span></th>
        </tr></thead>
        <tbody>
        {% for a in list.items %}
            {% set status = w4os_status(a) %}
            <tr class="w4os-{{ status }}">
                <td class="w4os-name">
                    <img class="w4os-thumb" src="{{ w4os_picture(a.profileImage)|e('html_attr') }}" alt="" loading="lazy" width="32" height="32">
                    {{ a.name }}{% if a.isGod %} <span class="w4os-tag">{{ 'w4os.god'|t }}</span>{% endif %}{% if a.online %} <span class="w4os-tag">{{ 'w4os.online'|t }}</span>{% endif %}
                </td>
                <td>{{ a.email }}</td>
                <td>{{ a.lastSeen ? a.lastSeen|date('Y-m-d') : '—' }}</td>
                <td>{{ a.created ? a.created|date('Y-m-d') : '—' }}</td>
                <td><span class="w4os-status">{{ ('w4os.status_' ~ status)|t }}</span></td>
                <td class="w4os-actions">
                    {% set actions = w4os_actions(a) %}
                    {% if actions %}
                    <details class="w4os-menu">
                        <summary aria-label="{{ ('w4os.actions'|t ~ ': ' ~ a.name)|e('html_attr') }}" title="{{ 'w4os.actions'|t|e('html_attr') }}">⋮</summary>
                        <form method="post">
                            {{ nonce_field('w4os-manage')|raw }}
                            <input type="hidden" name="uuid" value="{{ a.uuid|e('html_attr') }}">
                            <input type="hidden" name="name" value="{{ a.name|e('html_attr') }}">
                            {% for action in actions %}
                                <button name="action" value="{{ action }}">{{ ('w4os.action_' ~ action)|t }}</button>
                            {% endfor %}
                        </form>
                    </details>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% set pages = ((list.meta.total ?? 0) / (list.meta.perPage ?: 50))|round(0, 'ceil') %}
    {% if pages > 1 %}
        <p class="w4os-pages">
        {% for n in 1..pages %}
            {% if n == (list.meta.page ?? 1) %}<strong>{{ n }}</strong>{% else %}<a href="?{{ {search: uri.query('search'), page: n}|url_encode }}">{{ n }}</a>{% endif %}
        {% endfor %}
        </p>
    {% endif %}
{% endif %}
