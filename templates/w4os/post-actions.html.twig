{# The actions of a post of the visitor's own stream (w4os-views PostsView), in a small menu at the end of the post (⋮, vertical dots), posted to
   its profile page; the ones the engine asks to confirm (ask) are confirmed first #}
<details class="w4os-post-menu">
    <summary aria-label="{{ 'w4os.actions'|t|e('html_attr') }}" title="{{ 'w4os.actions'|t|e('html_attr') }}">⋮</summary>
    <form method="post" class="w4os-post-actions">{{ nonce_field('w4os-post')|raw }}<input type="hidden" name="post" value="{{ post|e('html_attr') }}">
        {%- for action in view.actions %}<button name="action" value="{{ action.name|e('html_attr') }}"{% if action.ask %} data-w4os-ask="{{ ('w4os.' ~ action.ask)|t|e('html_attr') }}" onclick="return confirm(this.dataset.w4osAsk)"{% endif %} class="w4os-post-action{% if action.danger %} w4os-danger{% endif %}">{{ ('w4os.' ~ action.label)|t }}</button>{% endfor -%}
    </form>
</details>
