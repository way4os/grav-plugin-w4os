{# The avatar models of the grid, for the managers the contract lets read their rule, laid out as w4os-wp has them: the form of the
   rule (the settings `models` of the grid: which avatars are models) for whom the contract lets change it, under it the models it
   picks (its preview: each its picture and name, a new avatar wears a copy of its outfit), updated as the form is changed
   (js/models-preview.js), its help (the points of its description) beside them #}
{% set rule = w4os_models_rule() %}
{% if rule.error %}
    <div class="alert alert-danger" role="alert">{{ rule.error }}</div>
{% endif %}
{% set preview %}
    <div class="card">
        <div class="card-header"><h3 class="card-title">{{ ('w4os.' ~ (rule.preview.label ?? 'models_list'))|t }}</h3></div>
        <div class="card-body w4os-models-preview"{% if rule.preview and rule.changeable %} data-w4os-models-preview="{{ ('?format=preview')|e('html_attr') }}" data-form="w4os-models" data-filters="{{ rule.preview.filters|json_encode|e('html_attr') }}" aria-live="polite"{% endif %}>
            {% include 'w4os/models-preview.html.twig' with { models: w4os_models() ?? [] } %}
        </div>
    </div>
{% endset %}
{% if not rule.error and rule.changeable %}
    {# The form then the models it picks, its help beside them #}
    <div class="row row-cards">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    {% include 'w4os/admin-form.html.twig' with { form: forms('w4os-models') } %}
                </div>
            </div>
            {{ preview }}
        </div>
        {% if rule.help %}
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <ul class="w4os-models-help text-secondary mb-0">
                            {% for key in rule.help %}<li>{{ ('w4os.' ~ key)|t }}</li>{% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% else %}
    {{ preview }}
{% endif %}
{% if rule.preview and rule.changeable %}
    {% do assets.addJs('plugin://w4os/js/models-preview.js', {group: 'bottom', loading: 'defer'}) %}
{% endif %}
