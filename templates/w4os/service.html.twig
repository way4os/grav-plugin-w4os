{# The settings of a service of the grid (economy, search, guide, offline messages, web assets), for the managers the contract lets
   read them, as w4os-wp has them: the form as the engine describes it (x-form), as wide as the page, what the options of the grid set
   shown and unchangeable, its help beside it when it has one; its examples and the lines of the files it needs right after the form,
   in its column #}
{% set service = w4os_service() %}
{% if service.error %}
    <div class="alert alert-danger" role="alert">{{ service.error }}</div>
{% elseif service.view %}
    <div class="row row-cards">
        <div class="{{ service.help or service.tasks ? 'col-lg-8' : 'col-12' }}">
            <div class="card">
                <div class="card-body">
                    {% include 'w4os/admin-form.html.twig' with { form: forms('w4os-service') } %}
                </div>
            </div>
            {# The examples of the page (a list of destinations), after its form, in its column, apart from its settings #}
            {% for example in service.meta.examples ?? [] %}
                <div class="card mt-3">
                    <div class="card-header"><h3 class="card-title">{{ ('w4os.' ~ example.label)|t }}</h3></div>
                    <div class="card-body"><pre class="mb-0">{{ example.text }}</pre></div>
                </div>
            {% endfor %}
            {# The lines of the files of the grid the page needs, for the values saved: one block for each file, its name before it #}
            {% for snippet in service.meta.snippets ?? [] %}
                <div class="card mt-3 w4os-snippet">
                    <div class="card-body">
                        <div class="small text-secondary mb-2"><i class="ti ti-file-text" aria-hidden="true"></i> {{ snippet.file }}</div>
                        <pre class="mb-0">{{ snippet.text }}</pre>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% if service.help or service.tasks %}
            <div class="col-lg-4">
                {% if service.tasks %}
                    {# The tasks of the service, as w4os-wp shows its parser: when each last ran, what it said, a button to run it now #}
                    <div class="card mb-3">
                        <div class="list-group list-group-flush">
                            {% for task in service.tasks %}
                                <div class="list-group-item">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="flex-fill">
                                            <div>{{ task.label ?? task.name }}</div>
                                            <div class="small text-secondary">{% if task.lastRun %}{{ 'w4os.admin_task_last'|t(w4os_time(task.lastRun))|raw }}{% else %}{{ 'w4os.admin_task_never'|t }}{% endif %}{% if task.message %} · {{ task.message }}{% endif %}</div>
                                        </div>
                                        {% if service.run %}
                                            <form method="post">{{ nonce_field('w4os-task')|raw }}<input type="hidden" name="task" value="{{ task.id|e('html_attr') }}"><button class="btn btn-sm" name="action" value="run_task">{{ 'w4os.admin_task_run'|t }}</button></form>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
                {% if service.help %}
                    <div class="card">
                        <div class="card-body">
                            <ul class="text-secondary mb-0">
                                {% for key in service.help %}<li>{{ ('w4os.' ~ key)|t }}</li>{% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endif %}
