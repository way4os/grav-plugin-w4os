{# A page laid out like the splash page of the helpers (the one a viewer shows), with their blocks: what the grid is on the left,
   the page, the popular places and the destinations guide in the middle, the message of the day on the right. Front matter: `template: w4os/splash`. #}
{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="w4os-splash">
        <aside class="w4os-splash-left">
            {{ w4os_block('grid-info') }}
            {{ w4os_block('grid-status') }}
        </aside>
        <article class="content-item w4os-splash-main">
            {{ page.content|raw }}
            {{ w4os_block('popular-places') }}
            {{ w4os_block('destination_guide') }}
        </article>
        <aside class="w4os-splash-right">
            {{ w4os_block('motd') }}
        </aside>
    </div>
{% endblock %}
