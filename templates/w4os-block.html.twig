{# A page of the grid the site serves (pages/search.md, profile.md, guide.md): the block of the helpers alone, under its own title.
   A viewer that asks gets it without the top bar, the menus and the footer of the site (the helpers' detection of a viewer). #}
{% extends 'partials/base.html.twig' %}

{% block header %}{% if not w4os_is_viewer() %}{{ parent() }}{% endif %}{% endblock %}
{% block footer %}{% if not w4os_is_viewer() %}{{ parent() }}{% endif %}{% endblock %}
{% block mobile %}{% if not w4os_is_viewer() %}{{ parent() }}{% endif %}{% endblock %}

{% block content %}
    {# The messages given while the page renders (the notices of the blocks of the helpers), put here by the plugin #}
    <!-- w4os:messages -->
    <div class="w4os w4os-page w4os-{{ page.header.w4os|e('html_attr') }}">
        {# A profile its owner or a manager may change: the way to its edit page #}
        {% set edit_url = page.header.w4os == 'profile' and not w4os_is_viewer() ? w4os_profile_edit_url() : null %}
        {{ w4os_block(page.header.w4os_block, w4os_page_args()) }}
        {% if edit_url %}
            {# Its actions under it, where the edit page has its own, as the Form plugin draws its buttons (the theme's classes); the
               tab open goes with the button (js/keep-tab.js) #}
            {% do assets.addJs('plugin://w4os/js/keep-tab.js', {group: 'bottom', loading: 'defer'}) %}
            <div class="{{ form_button_outer_classes ?: 'buttons' }} w4os-profile-actions">
                <a href="{{ edit_url|e('html_attr') }}" data-w4os-keep-tab><button type="button" class="{{ form_button_classes ?: 'button' }} button primary">{{ 'w4os.action_edit'|t }}</button></a>
            </div>
        {% endif %}
    </div>
{% endblock %}
