{# The admin pages of the plugin (dashboard, simulators, regions, avatars): a layout of its own on Tabler, never the theme's, so a
   change of theme or of the styles of the site cannot break it; the identity of the site in it (its title, its logo, its accent
   color as the primary color of Tabler, w4os_brand()), the light or dark mode of the visitor. One sidebar of the sections the
   visitor opens (w4os_admin_menu()), a drawer on a phone; the page in the main area. #}
{% set brand = w4os_brand() %}
{% set menu = w4os_admin_menu()|default([]) %}
{% set visitor = grav.user.w4os ?? null %}
<!doctype html>
<html lang="{{ (grav.language.getActive ?: 'en')|e('html_attr') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ page.title }}{{ brand.title ? ' | ' ~ brand.title }}</title>
    {# The icon of w4os, the admin's own whatever the theme, its favicon and its icon for a phone's home screen #}
    {% set icons = 'plugin://w4os/vendor/w4os/w4os-engine/share/images/logos/cropped-w4os-logo-v1-square-' %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ url(icons ~ '32x32.png')|e('html_attr') }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ url(icons ~ '192x192.png')|e('html_attr') }}">
    <link rel="apple-touch-icon" href="{{ url(icons ~ '180x180.png')|e('html_attr') }}">
    {# The scripts of the forms run: the fields their values hide stay hidden from the start (js/conditions.js) #}
    <script>document.documentElement.classList.add('w4os-js');</script>
    {# Tabler, its icons and the admin's own styles, served by the plugin (vendor/npm-asset, pinned) #}
    <link rel="stylesheet" href="{{ url('plugin://w4os/vendor/npm-asset/tabler-core/dist/css/tabler.min.css')|e('html_attr') }}">
    <link rel="stylesheet" href="{{ url('plugin://w4os/vendor/npm-asset/tabler-core/dist/libs/tom-select/dist/css/tom-select.bootstrap5.min.css')|e('html_attr') }}">
    <link rel="stylesheet" href="{{ url('plugin://w4os/vendor/npm-asset/tabler-core/dist/css/tabler-vendors.min.css')|e('html_attr') }}">
    <link rel="stylesheet" href="{{ url('plugin://w4os/vendor/npm-asset/tabler-icons-webfont/dist/tabler-icons.min.css')|e('html_attr') }}">
    <link rel="stylesheet" href="{{ url('plugin://w4os/css/admin.css')|e('html_attr') }}">
    {# Before the page renders: Tabler's theme script (the light or dark mode of the visitor's system, followed when it changes; the
       sidebar as the manager pinned or folded it), then the sidebar folded below xl while they have not chosen #}
    <script src="{{ url('plugin://w4os/vendor/npm-asset/tabler-core/dist/js/tabler-theme.min.js')|e('html_attr') }}"></script>
    <script src="{{ url('plugin://w4os/js/sidebar.js')|e('html_attr') }}"></script>
    {% if brand.color is defined %}
    {# The accent color of the site as the primary color of Tabler, its variants derived by Tabler from it #}
    <style>
        :root, [data-bs-theme] {
            --tblr-primary: {{ brand.color }};
            --tblr-primary-rgb: {{ brand.rgb }};
            --tblr-primary-lt-rgb: {{ brand['lt-rgb'] }};
        }
    </style>
    {% endif %}
</head>
<body class="w4os-admin">
<div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#w4os-sidebar" aria-controls="w4os-sidebar" aria-expanded="false" aria-label="{{ 'w4os.menu_admin'|t|e('html_attr') }}">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-brand">
                <a class="w4os-admin-brand" href="{{ brand.home|e('html_attr') }}" title="{{ brand.title|e('html_attr') }}">
                    {# The icon of the site in the folded rail; unfolded, its logo alone (its title as its text), else its title #}
                    <img class="navbar-brand-image w4os-admin-icon" src="{{ (brand.icon ?? url('plugin://w4os/vendor/w4os/w4os-engine/share/images/logos/cropped-w4os-logo-v1-square-32x32.png'))|e('html_attr') }}" alt="" width="32" height="32">
                    <span class="w4os-admin-brand-full">{% if brand.logo %}<img class="w4os-admin-logo" src="{{ brand.logo|e('html_attr') }}" alt="{{ brand.title|e('html_attr') }}">{% else %}<span class="w4os-admin-title">{{ brand.title }}</span>{% endif %}</span>
                </a>
                {# Tabler's pin button: the sidebar kept unfolded, or folded to its icons (unfolded on hover), saved in the browser #}
                <button type="button" class="btn btn-action btn-sm d-none d-lg-inline-flex" data-bs-toggle="sidebar-folded" aria-pressed="false" aria-label="{{ 'w4os.admin_sidebar_pin'|t|e('html_attr') }}" title="{{ 'w4os.admin_sidebar_pin'|t|e('html_attr') }}"><i class="ti ti-pin" aria-hidden="true"></i></button>
            </div>
            <div class="collapse navbar-collapse" id="w4os-sidebar">
                <ul class="navbar-nav pt-lg-3">
                    {% for item in menu %}
                    {% if item.heading ?? false %}
                    {# A section of pages with nothing in common (Services): its name, a line in the folded sidebar #}
                    <li class="nav-item w4os-nav-heading"><span class="subheader nav-link-title">{{ item.label }}</span></li>
                    {% elseif item.children ?? false %}
                    {# An entry with pages under it (Regions: its list, the map; a section: Services, Tools, Site), Tabler's chevron telling it:
                       a click leads to its first page at once (no toggle), its pages shown under it (Tabler's dropdown menu) on the page of one
                       of them #}
                    <li class="nav-item dropdown{{ item.active ? ' active' }}{{ item.gap ?? false ? ' w4os-nav-gap' }}">
                        <a class="nav-link dropdown-toggle" href="{{ item.url|e('html_attr') }}"{% if item.active %} aria-expanded="true"{% endif %}>
                            {% if item.icon is defined %}<span class="nav-link-icon"><i class="{{ item.icon|e('html_attr') }}" aria-hidden="true"></i></span>{% endif %}
                            <span class="nav-link-title">{{ item.label }}</span>
                        </a>
                        <div class="dropdown-menu{{ item.active ? ' show' }}">
                            {% for child in item.children %}
                            <a class="dropdown-item{{ child.active ?? false ? ' active' }}" href="{{ child.url|e('html_attr') }}"{% if child.active ?? false %} aria-current="page"{% endif %}>{{ child.label }}</a>
                            {% endfor %}
                        </div>
                    </li>
                    {% else %}
                    <li class="nav-item{{ item.active ?? false ? ' active' }}{{ item.gap ?? false ? ' w4os-nav-gap' }}">
                        <a class="nav-link" href="{{ item.url|e('html_attr') }}"{% if item.active ?? false %} aria-current="page"{% endif %}>
                            {% if item.icon is defined %}<span class="nav-link-icon"><i class="{{ item.icon|e('html_attr') }}" aria-hidden="true"></i></span>{% endif %}
                            <span class="nav-link-title">{{ item.label }}</span>
                        </a>
                    </li>
                    {% endif %}
                    {% endfor %}
                </ul>
                {# The visitor: the site, its profile, sign out; at the bottom of the sidebar (Tabler's navbar-footer) #}
                <div class="navbar-footer">
                <ul class="navbar-nav w4os-admin-visitor">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ brand.home|e('html_attr') }}"><span class="nav-link-icon"><i class="ti ti-world" aria-hidden="true"></i></span><span class="nav-link-title">{{ brand.title }}</span></a>
                    </li>
                    {% if visitor %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ w4os_url(config.plugins.w4os.routes.account ?? '/account')|e('html_attr') }}"><span class="nav-link-icon"><i class="ti ti-user-circle" aria-hidden="true"></i></span><span class="nav-link-title">{{ visitor.name }}</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ url(uri.addNonce((uri.path)|trim('/') ~ '/task' ~ config.system.param_sep ~ 'login.logout', 'logout-form', 'logout-nonce'))|e('html_attr') }}"><span class="nav-link-icon"><i class="ti ti-logout" aria-hidden="true"></i></span><span class="nav-link-title">{{ 'w4os.logout'|t }}</span></a>
                    </li>
                    {% endif %}
                </ul>
                </div>
            </div>
        </div>
    </aside>
    <div class="page-wrapper">
        {# The header of the page: an item's (its name, state and actions), a page's own (w4os/<page>-header.html.twig), else its title #}
        {% include [page.header.w4os_item is defined ? 'w4os/item-header.html.twig' : 'w4os/' ~ page.header.w4os ~ '-header.html.twig', 'w4os/admin-header.html.twig'] %}
        <div class="page-body">
            <div class="container-fluid">
                {# The messages given while the page renders, put here by the plugin #}
                <!-- w4os:admin-messages -->
                <div class="w4os w4os-page w4os-{{ page.header.w4os|e('html_attr') }}">
                    {% include page.header.w4os starts with 'settings_' ? 'w4os/service.html.twig' : 'w4os/' ~ page.header.w4os ~ '.html.twig' %}
                </div>
            </div>
        </div>
    </div>
</div>
<script src="{{ url('plugin://w4os/vendor/npm-asset/tabler-core/dist/js/tabler.min.js')|e('html_attr') }}" defer></script>
{# The times of the page in the browser's own time (w4os_time) #}
<script src="{{ url('plugin://w4os/js/dates.js')|e('html_attr') }}" defer></script>
{# What the page added (the scripts of its lists and forms), once it is rendered; of the styles, the plugin's and the Form plugin's
   alone (the other plugins' are for the site) #}
{{ w4os_admin_css(assets.css())|raw }}
{{ assets.js()|raw }}
{{ assets.js('bottom')|raw }}
</body>
</html>
