{# The terms of the site to agree to, when the setting register.terms names their page. #}
{% set terms = config.plugins.w4os.register.terms %}
{% if terms %}
    <div class="form-field w4os-terms">
        <label class="inline">
            <input type="checkbox" name="{{ (scope ~ field.name)|fieldName }}" value="1" required>
            {{ 'w4os.terms_agree'|t('<a href="' ~ w4os_url(terms)|e('html_attr') ~ '" target="_blank">' ~ terms|e ~ '</a>')|raw }}
        </label>
    </div>
{% endif %}
