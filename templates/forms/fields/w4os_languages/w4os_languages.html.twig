{# The languages of an avatar: free text, as in the viewer ("Français, English"), typed as tags (Tom Select, vendor/npm-asset/tom-select)
   with the site's languages and the usual ones to pick from, each in its own language; a plain text field without the script #}
{% extends "forms/fields/text/text.html.twig" %}

{% block input_attributes %}
    {{ parent() }}
    list="w4os-languages-{{ field.name|e('html_attr') }}"
    data-w4os-languages
{% endblock %}

{% block append %}
    {{ parent() }}
    {% do assets.addCss('plugin://w4os/vendor/npm-asset/tom-select/dist/css/tom-select.min.css') %}
    {% do assets.addJs('plugin://w4os/vendor/npm-asset/tom-select/dist/js/tom-select.popular.min.js', {group: 'bottom', loading: 'defer'}) %}
    {% do assets.addJs('plugin://w4os/js/languages.js', {group: 'bottom', loading: 'defer'}) %}
    <datalist id="w4os-languages-{{ field.name|e('html_attr') }}">
        {% for name in w4os_language_names() %}<option value="{{ name }}"></option>{% endfor %}
    </datalist>
{% endblock %}
