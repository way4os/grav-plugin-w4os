{# The choice of the theme of the site as a gallery (the settings of the site): the themes installed, each its picture (the
   thumbnail.jpg Grav gives its blueprint) and its name, the current one checked; a radio each, Tabler's selectable cards
   (form-imagecheck) as many a row as the width holds, no script #}
{% extends "forms/field.html.twig" %}

{% block input %}
    <div class="w4os-themes" role="radiogroup">
        {% for theme, name in field.options %}
            <div>
                <label class="form-imagecheck mb-1">
                    <input type="radio" name="{{ (scope ~ field.name)|fieldName }}" value="{{ theme|e('html_attr') }}" class="form-imagecheck-input"{% if theme == value %} checked{% endif %}{% if field.validate.required %} required{% endif %}>
                    <span class="form-imagecheck-figure">
                        {% if field.thumbnails[theme] is defined and field.thumbnails[theme] %}
                            <img src="{{ field.thumbnails[theme] }}" alt="" class="form-imagecheck-image" loading="lazy">
                        {% else %}
                            <span class="form-imagecheck-image w4os-theme-none" aria-hidden="true"></span>
                        {% endif %}
                    </span>
                    <span class="form-imagecheck-caption">{{ name }}</span>
                </label>
            </div>
        {% endfor %}
    </div>
{% endblock %}
